---
import Header from '../components/Header.astro';
import '../styles/global.css';

const {
  title = 'Inicio',
  description = 'ASHÉ Medio Comunitario Afro: historias, memoria, identidad, cultura y territorio de las comunidades afrodescendientes en Bogotá.',
  image = '/images/logo.jpeg'
} = Astro.props;

const siteName = 'ASHÉ Medio Comunitario Afro';
const siteURL = 'https://web-ashe.vercel.app';

const fullTitle =
  title === 'Inicio'
    ? siteName
    : `${title} | ${siteName}`;

const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const imageURL = new URL(image, siteURL).href;

const isHome = Astro.url.pathname === '/';
---

<!DOCTYPE html>
<html lang="es">

<head>

  <!-- =================================
       CONFIGURACIÓN BÁSICA
  ================================== -->

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="theme-color"
    content="#1B1B1B"
  />


  <!-- =================================
       SEO
  ================================== -->

  <title>{fullTitle}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="author"
    content="ASHÉ Medio Comunitario Afro"
  />

  <meta
    name="robots"
    content="index, follow"
  />

  <link
    rel="canonical"
    href={canonicalURL}
  />


  <!-- =================================
       FAVICON
  ================================== -->

  <link
    rel="icon"
    type="image/jpeg"
    href="/images/logo.jpeg"
  />

  <link
    rel="apple-touch-icon"
    href="/images/logo.jpeg"
  />


  <!-- =================================
       OPEN GRAPH
  ================================== -->

  <meta
    property="og:type"
    content={isHome ? 'website' : 'article'}
  />

  <meta
    property="og:title"
    content={fullTitle}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonicalURL}
  />

  <meta
    property="og:image"
    content={imageURL}
  />

  <meta
    property="og:site_name"
    content={siteName}
  />

  <meta
    property="og:locale"
    content="es_CO"
  />


  <!-- =================================
       TWITTER / X
  ================================== -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={fullTitle}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={imageURL}
  />


  <!-- =================================
       DATOS ESTRUCTURADOS
       IDENTIDAD DE ASHÉ
  ================================== -->

  {isHome && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "ASHÉ Medio Comunitario Afro",
        "url": siteURL,
        "logo": `${siteURL}/images/logo.jpeg`,
        "description": "ASHÉ Medio Comunitario Afro: historias, memoria, identidad, cultura y territorio de las comunidades afrodescendientes en Bogotá."
      })}
    />
  )}


  <!-- =================================
       DATOS ESTRUCTURADOS
       SITIO WEB
  ================================== -->

  {isHome && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "ASHÉ Medio Comunitario Afro",
        "url": siteURL,
        "description": "Medio comunitario afro que visibiliza historias, memoria, cultura, identidad y procesos de las comunidades negras y afrocolombianas."
      })}
    />
  )}

</head>


<body>

  <!-- =================================
       ENCABEZADO
  ================================== -->

  <Header />


  <!-- =================================
       CONTENIDO PRINCIPAL
  ================================== -->

  <main>

    <slot />

  </main>

</body>

</html>