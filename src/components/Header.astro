---
const menuItems = [
  { name: "Inicio", href: "/" },
  { name: "Noticias", href: "/#noticias" },
  { name: "Agenda", href: "/#agenda" },
  { name: "Nosotros", href: "/quienes-somos" },
  { name: "Actualidad Afro", href: "/actualidad" },
  { name: "Memoria", href: "/memoria" },
  { name: "Comunidad", href: "/comunidad" },
  { name: "Cultura", href: "/cultura" },
  { name: "Oportunidades", href: "/oportunidades" }
];

const desktopMenuItems = menuItems.slice(4);

const currentPath = Astro.url.pathname;
---

<header class="header">

  <div class="header-container">

    <!-- =========================================
         LOGO
    ========================================== -->

    <a
      href="/"
      class="logo-container"
      aria-label="ASHÉ - Inicio"
    >

      <img
        src="/images/logo.jpeg"
        alt="Logo ASHÉ Medio Comunitario Afro"
        class="logo"
      />

      <div class="logo-text">

        <h1>ASHÉ</h1>

        <p>
          MEDIO COMUNITARIO AFRO
        </p>

      </div>

    </a>


    <!-- =========================================
         NAVEGACIÓN PRINCIPAL — PC
    ========================================== -->

    <nav
      class="desktop-nav"
      aria-label="Navegación principal"
    >

      <a
        href="/"
        class:list={{
          active: currentPath === "/"
        }}
      >
        INICIO
      </a>

      <a href="/#noticias">
        NOTICIAS
      </a>

      <a href="/#agenda">
        AGENDA
      </a>

      <a
        href="/quienes-somos"
        class:list={{
          active: currentPath.startsWith("/quienes-somos")
        }}
      >
        NOSOTROS
      </a>

    </nav>


    <!-- =========================================
         BOTÓN HAMBURGUESA
         PC + CELULAR
    ========================================== -->

    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="main-navigation"
    >

      <span></span>
      <span></span>
      <span></span>

    </button>


    <!-- =========================================
         MENÚ LATERAL
    ========================================== -->

    <nav
      class="nav"
      id="main-navigation"
      aria-label="Secciones del sitio"
    >

      <div class="nav-header">

        <span>
          SECCIONES
        </span>

        <span class="nav-header-line"></span>

      </div>


      <!-- =========================================
           MENÚ PARA PC
           SOLO 01 - 05
           
           Actualidad
           Memoria
           Comunidad
           Cultura
           Oportunidades
      ========================================== -->

      <div class="nav-links nav-links-desktop">

        {
          desktopMenuItems.map((item, index) => {

            const isActive =
              currentPath.startsWith(item.href);

            return (
              <a
                href={item.href}
                class:list={{
                  active: isActive
                }}
              >

                <span class="nav-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="nav-name">
                  {item.name}
                </span>

                <span class="nav-arrow">
                  →
                </span>

              </a>
            );

          })
        }

      </div>


      <!-- =========================================
           MENÚ PARA CELULAR
           TODAS 01 - 09
      ========================================== -->

      <div class="nav-links nav-links-mobile">

        {
          menuItems.map((item, index) => {

            const isHome =
              item.href === "/";

            const isAnchor =
              item.href.startsWith("/#");

            const isActive =
              isHome
                ? currentPath === "/"
                : !isAnchor &&
                  currentPath.startsWith(item.href);

            return (
              <a
                href={item.href}
                class:list={{
                  active: isActive
                }}
                aria-current={
                  isActive
                    ? "page"
                    : undefined
                }
              >

                <span class="nav-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="nav-name">
                  {item.name}
                </span>

                <span class="nav-arrow">
                  →
                </span>

              </a>
            );

          })
        }

      </div>

    </nav>

  </div>

</header>


<!-- =========================================
     FONDO DEL MENÚ
========================================== -->

<div
  class="menu-backdrop"
  aria-hidden="true"
></div>


<script>

  const menuToggle =
    document.querySelector(".menu-toggle");

  const navigation =
    document.querySelector("#main-navigation");

  const backdrop =
    document.querySelector(".menu-backdrop");


  /* =========================================
     CERRAR MENÚ
  ========================================== */

  function closeMenu() {

    if (
      !navigation ||
      !menuToggle ||
      !backdrop
    ) {
      return;
    }

    navigation.classList.remove("open");

    menuToggle.classList.remove("open");

    backdrop.classList.remove("open");

    menuToggle.setAttribute(
      "aria-expanded",
      "false"
    );

    menuToggle.setAttribute(
      "aria-label",
      "Abrir menú"
    );

    document.body.classList.remove(
      "menu-open"
    );

  }


  /* =========================================
     ABRIR MENÚ
  ========================================== */

  function openMenu() {

    if (
      !navigation ||
      !menuToggle ||
      !backdrop
    ) {
      return;
    }

    navigation.classList.add("open");

    menuToggle.classList.add("open");

    backdrop.classList.add("open");

    menuToggle.setAttribute(
      "aria-expanded",
      "true"
    );

    menuToggle.setAttribute(
      "aria-label",
      "Cerrar menú"
    );

    document.body.classList.add(
      "menu-open"
    );

  }


  /* =========================================
     BOTÓN HAMBURGUESA
  ========================================== */

  if (
    menuToggle &&
    navigation
  ) {

    menuToggle.addEventListener(
      "click",
      () => {

        const isOpen =
          navigation.classList.contains(
            "open"
          );

        if (isOpen) {

          closeMenu();

        } else {

          openMenu();

        }

      }
    );


    /* =========================================
       CERRAR AL SELECCIONAR
    ========================================== */

    navigation
      .querySelectorAll("a")
      .forEach((link) => {

        link.addEventListener(
          "click",
          () => {

            closeMenu();

          }
        );

      });


    /* =========================================
       CERRAR AL HACER CLIC AFUERA
    ========================================== */

    if (backdrop) {

      backdrop.addEventListener(
        "click",
        () => {

          closeMenu();

        }
      );

    }


    /* =========================================
       CERRAR CON ESC
    ========================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape"
        ) {

          closeMenu();

        }

      }
    );

  }

</script>


<style>

/* ==================================================
   HEADER GENERAL
================================================== */

.header {

  position: relative;

  width: 100%;

  z-index: 1400;

  background: #F7F4ED;

  border-bottom:
    1px solid rgba(
      27,
      27,
      27,
      0.08
    );
}


/* ==================================================
   CONTENEDOR
================================================== */

.header-container {

  width:
    min(
      1180px,
      calc(100% - 40px)
    );

  min-height: 88px;

  margin: 0 auto;

  display: flex;

  align-items: center;

  gap: 30px;
}


/* ==================================================
   LOGO
================================================== */

.logo-container {

  display: flex;

  align-items: center;

  gap: 12px;

  flex-shrink: 0;

  color: #1B1B1B;

  text-decoration: none;
}


.logo {

  width: 52px;

  height: 52px;

  object-fit: cover;

  border-radius: 50%;

  border:
    2px solid #C8A24A;

  transition:
    transform 0.25s ease;
}


.logo-container:hover .logo {

  transform:
    rotate(-3deg)
    scale(1.04);
}


.logo-text {

  display: flex;

  flex-direction: column;

  justify-content: center;
}


.logo-text h1 {

  margin: 0;

  color: #1B1B1B;

  font-size: 1.55rem;

  line-height: 1;

  font-weight: 800;

  letter-spacing: 2px;
}


.logo-text p {

  margin: 5px 0 0;

  color: #A8572B;

  font-size: 0.52rem;

  font-weight: 800;

  letter-spacing: 1.4px;

  white-space: nowrap;
}


/* ==================================================
   NAVEGACIÓN PRINCIPAL PC
================================================== */

.desktop-nav {

  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 28px;

  margin-left: auto;
}


.desktop-nav a {

  position: relative;

  padding: 8px 0;

  color: #1B1B1B;

  font-size: 0.63rem;

  font-weight: 800;

  letter-spacing: 1.2px;

  text-decoration: none;

  transition:
    color 0.25s ease;
}


.desktop-nav a::after {

  content: "";

  position: absolute;

  left: 0;

  bottom: 2px;

  width: 0;

  height: 2px;

  background: #A8572B;

  transition:
    width 0.25s ease;
}


.desktop-nav a:hover {

  color: #A8572B;
}


.desktop-nav a:hover::after {

  width: 100%;
}


.desktop-nav a.active {

  color: #A8572B;
}


.desktop-nav a.active::after {

  width: 100%;
}


/* ==================================================
   BOTÓN HAMBURGUESA
   VISIBLE EN PC Y CELULAR
================================================== */

.menu-toggle {

  position: relative;

  z-index: 1500;

  width: 48px;

  height: 48px;

  padding: 0;

  margin-left: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-direction: column;

  gap: 5px;

  border:
    1px solid rgba(
      27,
      27,
      27,
      0.14
    );

  border-radius: 10px;

  background: #FFFFFF;

  cursor: pointer;

  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    transform 0.25s ease;
}


.menu-toggle:hover {

  background:
    rgba(
      168,
      87,
      43,
      0.06
    );

  border-color:
    rgba(
      168,
      87,
      43,
      0.35
    );

  transform:
    translateY(-1px);
}


/* ==================================================
   RAYAS
================================================== */

.menu-toggle span {

  display: block;

  width: 22px;

  height: 2px;

  border-radius: 2px;

  background: #1B1B1B;

  transition:
    transform 0.25s ease,
    opacity 0.2s ease;
}


/* ==================================================
   HAMBURGUESA → X
================================================== */

.menu-toggle.open span:nth-child(1) {

  transform:
    translateY(7px)
    rotate(45deg);
}


.menu-toggle.open span:nth-child(2) {

  opacity: 0;
}


.menu-toggle.open span:nth-child(3) {

  transform:
    translateY(-7px)
    rotate(-45deg);
}


/* ==================================================
   MENÚ LATERAL
================================================== */

.nav {

  position: fixed;

  top: 0;

  right: 0;

  width:
    min(
      420px,
      92vw
    );

  height: 100vh;

  padding:
    105px 38px 35px;

  display: flex;

  flex-direction: column;

  background: #F7F4ED;

  box-shadow:
    -20px 0 60px
    rgba(
      27,
      27,
      27,
      0.16
    );

  overflow-y: auto;

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transform:
    translateX(100%);

  z-index: 1450;

  transition:
    opacity 0.3s ease,
    visibility 0.3s ease,
    transform 0.35s
      cubic-bezier(
        0.22,
        1,
        0.36,
        1
      );
}


.nav.open {

  opacity: 1;

  visibility: visible;

  pointer-events: auto;

  transform:
    translateX(0);
}


/* ==================================================
   CABECERA DEL MENÚ
================================================== */

.nav-header {

  display: flex;

  align-items: center;

  gap: 15px;

  margin-bottom: 25px;
}


.nav-header > span:first-child {

  color: #A8572B;

  font-size: 0.65rem;

  font-weight: 900;

  letter-spacing: 2.5px;

  white-space: nowrap;
}


.nav-header-line {

  width: 100%;

  height: 1px;

  background:
    rgba(
      27,
      27,
      27,
      0.12
    );
}


/* ==================================================
   LISTAS DEL MENÚ
================================================== */

.nav-links {

  display: flex;

  flex-direction: column;
}


/* PC → solamente 01–05 */

.nav-links-desktop {

  display: flex;
}


/* Celular → 01–09 */

.nav-links-mobile {

  display: none;
}


/* ==================================================
   ENLACES
================================================== */

.nav a {

  position: relative;

  display: grid;

  grid-template-columns:
    35px 1fr 25px;

  align-items: center;

  min-height: 58px;

  padding: 0 5px;

  border-bottom:
    1px solid rgba(
      27,
      27,
      27,
      0.10
    );

  color: #1B1B1B;

  text-decoration: none;

  transition:
    color 0.25s ease,
    padding 0.25s ease,
    background 0.25s ease;
}


.nav a:first-child {

  border-top:
    1px solid rgba(
      27,
      27,
      27,
      0.10
    );
}


.nav-number {

  color: #A8572B;

  font-size: 0.58rem;

  font-weight: 900;

  letter-spacing: 1px;
}


.nav-name {

  font-size: 0.98rem;

  font-weight: 700;

  letter-spacing: -0.3px;
}


.nav-arrow {

  color: #999;

  font-size: 1.05rem;

  text-align: right;

  transition:
    transform 0.25s ease,
    color 0.25s ease;
}


/* ==================================================
   HOVER
================================================== */

.nav a:hover {

  padding-left: 12px;

  color: #A8572B;

  background:
    rgba(
      168,
      87,
      43,
      0.045
    );
}


.nav a:hover .nav-arrow {

  color: #A8572B;

  transform:
    translateX(5px);
}


/* ==================================================
   ACTIVO
================================================== */

.nav a.active {

  color: #A8572B;

  font-weight: 800;

  background:
    rgba(
      168,
      87,
      43,
      0.07
    );
}


.nav a.active .nav-arrow {

  color: #A8572B;

  transform:
    translateX(3px);
}


/* ==================================================
   FONDO DEL MENÚ
================================================== */

.menu-backdrop {

  position: fixed;

  inset: 0;

  z-index: 1300;

  background:
    rgba(
      27,
      27,
      27,
      0.35
    );

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transition:
    opacity 0.3s ease,
    visibility 0.3s ease;
}


.menu-backdrop.open {

  opacity: 1;

  visibility: visible;

  pointer-events: auto;
}


/* ==================================================
   TABLET
================================================== */

@media (max-width: 950px) {

  .desktop-nav {

    gap: 18px;
  }


  .desktop-nav a {

    font-size: 0.57rem;

    letter-spacing: 0.9px;
  }


  .header-container {

    width:
      calc(100% - 30px);

    gap: 20px;
  }

}


/* ==================================================
   CELULAR
================================================== */

@media (max-width: 700px) {

  .header-container {

    min-height: 76px;

    width:
      calc(100% - 30px);

    justify-content:
      space-between;
  }


  /* Ocultar navegación superior */

  .desktop-nav {

    display: none;
  }


  /* Mantener hamburguesa */

  .menu-toggle {

    display: flex;

    margin-left: auto;
  }


  /* PC → 01–05 */

  .nav-links-desktop {

    display: none;
  }


  /* CELULAR → 01–09 */

  .nav-links-mobile {

    display: flex;

    flex-direction: column;
  }


  /* Logo */

  .logo {

    width: 46px;

    height: 46px;
  }


  .logo-text h1 {

    font-size: 1.35rem;
  }


  .logo-text p {

    font-size: 0.46rem;

    letter-spacing: 1.1px;
  }


  /* Menú lateral */

  .nav {

    width:
      min(
        390px,
        94vw
      );

    padding:
      95px 30px 30px;
  }

}


/* ==================================================
   CELULAR PEQUEÑO
================================================== */

@media (max-width: 450px) {

  .header-container {

    width:
      calc(100% - 24px);
  }


  .logo {

    width: 44px;

    height: 44px;
  }


  .logo-text h1 {

    font-size: 1.25rem;
  }


  .logo-text p {

    font-size: 0.43rem;

    letter-spacing: 1px;
  }


  .menu-toggle {

    width: 44px;

    height: 44px;
  }


  .nav {

    width: 100%;

    padding:
      90px 22px 25px;
  }


  .nav a {

    min-height: 56px;
  }


  .nav-name {

    font-size: 0.95rem;
  }

}


/* ==================================================
   BLOQUEAR SCROLL CON MENÚ ABIERTO
================================================== */

:global(body.menu-open) {

  overflow: hidden;
}

</style>