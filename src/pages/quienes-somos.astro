---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Quiénes Somos">

  <main class="about-page">

    <!-- ================================
         ENCABEZADO
    ================================= -->

    <section class="about-hero">

      <div class="container">

        <span class="section-label">
          CONOCE ASHÉ
        </span>

        <h1>
          Quiénes
          <span>Somos</span>
        </h1>

        <p>
          La Fuerza Cultural que mueve el Territorio.
        </p>

      </div>

    </section>


    <!-- ================================
         DESCRIPCIÓN
    ================================= -->

    <section class="about-section">

      <div class="container about-grid">

        <div class="about-intro">

          <span class="section-label">
            NUESTRA HISTORIA
          </span>

          <h2>
            Un medio nacido desde el territorio
          </h2>

        </div>


        <div class="about-text">

          <p>
            ASHÉ es un medio comunitario afro nacido en la localidad
            de Usme que trabaja por la visibilización de las culturas,
            memorias, saberes, liderazgos y procesos organizativos
            de las comunidades negras, afrocolombianas, raizales
            y palenqueras.
          </p>

          <p>
            A través de la comunicación comunitaria, la etnoeducación
            y la producción de contenidos culturales e informativos,
            promovemos el fortalecimiento de la identidad afrodescendiente,
            la participación ciudadana y la construcción colectiva
            del territorio.
          </p>

          <p>
            Nuestra labor inicia en Usme y se proyecta hacia Bogotá
            como un espacio de memoria, cultura, organización y
            transformación social.
          </p>

        </div>

      </div>

    </section>


    <!-- ================================
         FRASE
    ================================= -->

    <section class="about-quote">

      <div class="container">

        <div class="quote-line"></div>

        <h2>
          ASHÉ
        </h2>

        <p>
          La Fuerza Cultural que mueve el Territorio.
        </p>

      </div>

    </section>


    <!-- ================================
         MISIÓN Y VISIÓN
    ================================= -->

    <section class="about-section mission-section">

      <div class="container">

        <div class="section-heading">

          <span class="section-label">
            NUESTRO PROPÓSITO
          </span>

          <h2>
            Misión y Visión
          </h2>

        </div>


        <div class="mission-grid">

          <article class="mission-card">

            <div class="mission-number">
              01
            </div>

            <span class="mission-label">
              MISIÓN
            </span>

            <h3>
              Fortalecer la identidad
            </h3>

            <p>
              Visibilizar las culturas, saberes, liderazgos y procesos
              organizativos de las comunidades afrodescendientes mediante
              contenidos informativos, educativos y culturales que
              fortalezcan la memoria colectiva, la identidad cultural
              y la participación ciudadana.
            </p>

          </article>


          <article class="mission-card mission-card-dark">

            <div class="mission-number">
              02
            </div>

            <span class="mission-label">
              VISIÓN
            </span>

            <h3>
              Ser un medio referente
            </h3>

            <p>
              Para 2030, ser un medio comunitario afro referente en Bogotá
              por su aporte al fortalecimiento de la identidad
              afrodescendiente, la preservación de la memoria cultural
              y la promoción de iniciativas comunitarias para la
              transformación social y territorial.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- ================================
         PRINCIPIOS
    ================================= -->

    <section class="principles-section">

      <div class="container">

        <div class="section-heading center">

          <span class="section-label">
            LO QUE NOS MUEVE
          </span>

          <h2>
            Comunicación desde la comunidad
          </h2>

          <p>
            Nuestro trabajo busca que las comunidades puedan contar
            sus propias historias, fortalecer sus identidades y
            participar activamente en la construcción del territorio.
          </p>

        </div>


        <div class="principles-grid">

          <article class="principle-card">

            <span>01</span>

            <h3>
              Memoria
            </h3>

            <p>
              Rescatamos historias, saberes y experiencias que hacen
              parte de nuestra memoria colectiva.
            </p>

          </article>


          <article class="principle-card">

            <span>02</span>

            <h3>
              Identidad
            </h3>

            <p>
              Promovemos el reconocimiento y fortalecimiento de las
              identidades afrodescendientes.
            </p>

          </article>


          <article class="principle-card">

            <span>03</span>

            <h3>
              Participación
            </h3>

            <p>
              Abrimos espacios para que las voces de la comunidad
              hagan parte de las narrativas del territorio.
            </p>

          </article>


          <article class="principle-card">

            <span>04</span>

            <h3>
              Territorio
            </h3>

            <p>
              Entendemos el territorio como un espacio de cultura,
              organización, encuentro y transformación.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- ================================
         CIERRE
    ================================= -->

    <section class="about-ending">

      <div class="container">

        <h2>
          Nuestras voces,
          <span>nuestro territorio.</span>
        </h2>

        <p>
          ASHÉ apuesta por una comunicación comunitaria que permita
          contar nuestras realidades desde nuestras propias voces.
        </p>

        <a href="/" class="back-button">
          <span>←</span>
          Volver al inicio
        </a>

      </div>

    </section>

  </main>

</LayoutBase>


<style>

/* ================================
   GENERAL
================================= */

.about-page {

  background: #F7F4ED;

  color: #1B1B1B;
}


.container {

  width: min(1000px, calc(100% - 40px));

  margin: 0 auto;
}


.section-label {

  display: block;

  color: #A8572B;

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 2.3px;
}


/* ================================
   HERO
================================= */

.about-hero {

  min-height: 390px;

  display: flex;

  align-items: center;

  padding: 60px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.about-hero h1 {

  margin: 15px 0 12px;

  font-size:
    clamp(3.2rem, 7vw, 5.8rem);

  line-height: 0.92;

  letter-spacing: -3px;
}


.about-hero h1 span {

  display: block;

  color: #C8A24A;
}


.about-hero p {

  margin: 22px 0 0;

  color:
    rgba(
      247,
      244,
      237,
      0.7
    );

  font-size: 0.92rem;

  font-style: italic;

  line-height: 1.6;
}


/* ================================
   SECCIÓN HISTORIA
================================= */

.about-section {

  padding: 65px 20px;
}


.about-grid {

  display: grid;

  grid-template-columns:
    0.8fr 1.2fr;

  gap: 55px;

  align-items: center;
}


.about-intro h2 {

  margin: 12px 0 0;

  font-size:
    clamp(2rem, 4vw, 3.3rem);

  line-height: 1.05;

  letter-spacing: -1.5px;
}


.about-text {

  font-size: 0.86rem;

  line-height: 1.65;

  color: #444;
}


.about-text p {

  margin:
    0 0 18px;
}


/* ================================
   FRASE
================================= */

.about-quote {

  padding: 65px 20px;

  background: #A8572B;

  color: #F7F4ED;

  text-align: center;
}


.quote-line {

  width: 55px;

  height: 2px;

  margin:
    0 auto 20px;

  background: #C8A24A;
}


.about-quote h2 {

  margin: 0;

  font-size:
    clamp(2.8rem, 6vw, 4.5rem);

  line-height: 1;

  letter-spacing: 3px;
}


.about-quote p {

  margin:
    12px 0 0;

  color:
    rgba(
      247,
      244,
      237,
      0.8
    );

  font-size: 0.86rem;

  line-height: 1.5;
}


/* ================================
   MISIÓN Y VISIÓN
================================= */

.mission-section {

  background: #F7F4ED;
}


.section-heading {

  margin-bottom: 35px;
}


.section-heading h2 {

  margin:
    10px 0 0;

  font-size:
    clamp(2.1rem, 4vw, 3.3rem);

  line-height: 1;

  letter-spacing: -1.5px;
}


.mission-grid {

  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 15px;
}


.mission-card {

  position: relative;

  min-height: 285px;

  padding: 28px;

  overflow: hidden;

  border-radius: 15px;

  background: #FFFFFF;

  border:
    1px solid
    rgba(27,27,27,0.07);

  box-shadow:
    0 8px 25px
    rgba(27,27,27,0.05);
}


.mission-card-dark {

  background: #1B1B1B;

  color: #F7F4ED;
}


.mission-number {

  position: absolute;

  top: 20px;

  right: 23px;

  color: #C8A24A;

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 1.7px;
}


.mission-label {

  display: inline-block;

  margin-bottom: 14px;

  color: #A8572B;

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 1.7px;
}


.mission-card-dark .mission-label {

  color: #C8A24A;
}


.mission-card h3 {

  margin:
    0 0 14px;

  font-size: 1.3rem;

  line-height: 1.15;
}


.mission-card p {

  margin: 0;

  color: #666;

  font-size: 0.8rem;

  line-height: 1.6;
}


.mission-card-dark p {

  color:
    rgba(
      247,
      244,
      237,
      0.7
    );
}


/* ================================
   PRINCIPIOS
================================= */

.principles-section {

  padding: 65px 20px;

  background: #FFFFFF;
}


.section-heading.center {

  max-width: 680px;

  margin:
    0 auto 35px;

  text-align: center;
}


.section-heading.center p {

  margin:
    16px auto 0;

  color: #666;

  font-size: 0.84rem;

  line-height: 1.6;
}


.principles-grid {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 12px;
}


.principle-card {

  padding: 24px;

  border:
    1px solid
    rgba(27,27,27,0.08);

  border-radius: 12px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}


.principle-card:hover {

  transform: translateY(-4px);

  box-shadow:
    0 12px 25px
    rgba(27,27,27,0.07);
}


.principle-card > span {

  color: #A8572B;

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 1.7px;
}


.principle-card h3 {

  margin:
    12px 0 8px;

  font-size: 1.1rem;
}


.principle-card p {

  margin: 0;

  color: #666;

  font-size: 0.79rem;

  line-height: 1.55;
}


/* ================================
   CIERRE
================================= */

.about-ending {

  padding: 75px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.about-ending h2 {

  max-width: 650px;

  margin: 0 auto;

  font-size:
    clamp(2.2rem, 5vw, 3.4rem);

  line-height: 1;

  letter-spacing: -1.5px;
}


.about-ending h2 span {

  display: block;

  color: #C8A24A;
}


.about-ending p {

  max-width: 550px;

  margin:
    20px auto 0;

  color:
    rgba(
      247,
      244,
      237,
      0.65
    );

  font-size: 0.84rem;

  line-height: 1.6;
}


.back-button {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  margin-top: 25px;

  padding: 11px 18px;

  border:
    1px solid
    rgba(
      247,
      244,
      237,
      0.25
    );

  border-radius: 25px;

  color: #F7F4ED;

  font-size: 0.72rem;

  font-weight: 700;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}


.back-button:hover {

  transform: translateY(-2px);

  border-color: #C8A24A;

  color: #C8A24A;
}


/* ================================
   TABLET
================================= */

@media (max-width: 800px) {

  .about-hero {

    min-height: 380px;

    padding: 55px 20px;
  }


  .about-section {

    padding: 55px 20px;
  }


  .about-grid {

    grid-template-columns: 1fr;

    gap: 30px;
  }


  .mission-grid {

    grid-template-columns: 1fr;
  }


  .principles-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

}


/* ================================
   CELULAR
================================= */

@media (max-width: 550px) {

  .container {

    width:
      calc(100% - 32px);
  }


  .about-hero {

    min-height: 350px;

    padding: 50px 16px;
  }


  .about-hero h1 {

    font-size:
      clamp(3rem, 14vw, 4rem);

    letter-spacing: -2px;
  }


  .about-hero p {

    font-size: 0.82rem;
  }


  .about-section {

    padding: 55px 16px;
  }


  .about-grid {

    gap: 25px;
  }


  .about-intro h2 {

    font-size: 2.1rem;
  }


  .about-text {

    font-size: 0.82rem;

    line-height: 1.65;
  }


  .about-quote {

    padding: 55px 16px;
  }


  .about-quote h2 {

    font-size: 3.2rem;
  }


  .mission-card {

    min-height: auto;

    padding: 25px;
  }


  .principles-section {

    padding: 55px 16px;
  }


  .principles-grid {

    grid-template-columns: 1fr;
  }


  .principle-card {

    padding: 22px;
  }


  .about-ending {

    padding: 65px 16px;
  }


  .about-ending h2 {

    font-size: 2.1rem;
  }

}

</style>