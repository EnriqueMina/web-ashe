---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Quiénes Somos">

  <main class="about-page">

    <!-- ================================
         ENCABEZADO
    ================================= -->

    <section class="about-hero">

      <div class="container">

        <span class="section-label">
          CONOCE ASHÉ
        </span>

        <h1>
          Quiénes
          <span>Somos</span>
        </h1>

        <p>
          La Fuerza Cultural que mueve el Territorio.
        </p>

      </div>

    </section>


    <!-- ================================
         DESCRIPCIÓN
    ================================= -->

    <section class="about-section">

      <div class="container about-grid">

        <div class="about-intro">

          <span class="section-label">
            NUESTRA HISTORIA
          </span>

          <h2>
            Un medio nacido desde el territorio
          </h2>

        </div>


        <div class="about-text">

          <p>
            ASHÉ es un medio comunitario afro nacido en la localidad
            de Usme que trabaja por la visibilización de las culturas,
            memorias, saberes, liderazgos y procesos organizativos
            de las comunidades negras, afrocolombianas, raizales
            y palenqueras.
          </p>

          <p>
            A través de la comunicación comunitaria, la etnoeducación
            y la producción de contenidos culturales e informativos,
            promovemos el fortalecimiento de la identidad afrodescendiente,
            la participación ciudadana y la construcción colectiva
            del territorio.
          </p>

          <p>
            Nuestra labor inicia en Usme y se proyecta hacia Bogotá
            como un espacio de memoria, cultura, organización y
            transformación social.
          </p>

        </div>

      </div>

    </section>


    <!-- ================================
         FRASE
    ================================= -->

    <section class="about-quote">

      <div class="container">

        <div class="quote-line"></div>

        <h2>
          ASHÉ
        </h2>

        <p>
          La Fuerza Cultural que mueve el Territorio.
        </p>

      </div>

    </section>


    <!-- ================================
         MISIÓN Y VISIÓN
    ================================= -->

    <section class="about-section mission-section">

      <div class="container">

        <div class="section-heading">

          <span class="section-label">
            NUESTRO PROPÓSITO
          </span>

          <h2>
            Misión y Visión
          </h2>

        </div>


        <div class="mission-grid">

          <!-- MISIÓN -->

          <article class="mission-card">

            <div class="mission-number">
              01
            </div>

            <span class="mission-label">
              MISIÓN
            </span>

            <h3>
              Fortalecer la identidad
            </h3>

            <p>
              Visibilizar las culturas, saberes, liderazgos y procesos
              organizativos de las comunidades afrodescendientes mediante
              contenidos informativos, educativos y culturales que
              fortalezcan la memoria colectiva, la identidad cultural
              y la participación ciudadana.
            </p>

          </article>


          <!-- VISIÓN -->

          <article class="mission-card mission-card-dark">

            <div class="mission-number">
              02
            </div>

            <span class="mission-label">
              VISIÓN
            </span>

            <h3>
              Ser un medio referente
            </h3>

            <p>
              Para 2030, ser un medio comunitario afro referente en Bogotá
              por su aporte al fortalecimiento de la identidad
              afrodescendiente, la preservación de la memoria cultural
              y la promoción de iniciativas comunitarias para la
              transformación social y territorial.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- ================================
         PRINCIPIOS
    ================================= -->

    <section class="principles-section">

      <div class="container">

        <div class="section-heading center">

          <span class="section-label">
            LO QUE NOS MUEVE
          </span>

          <h2>
            Comunicación desde la comunidad
          </h2>

          <p>
            Nuestro trabajo busca que las comunidades puedan contar
            sus propias historias, fortalecer sus identidades y
            participar activamente en la construcción del territorio.
          </p>

        </div>


        <div class="principles-grid">

          <article class="principle-card">

            <span>01</span>

            <h3>
              Memoria
            </h3>

            <p>
              Rescatamos historias, saberes y experiencias que hacen
              parte de nuestra memoria colectiva.
            </p>

          </article>


          <article class="principle-card">

            <span>02</span>

            <h3>
              Identidad
            </h3>

            <p>
              Promovemos el reconocimiento y fortalecimiento de las
              identidades afrodescendientes.
            </p>

          </article>


          <article class="principle-card">

            <span>03</span>

            <h3>
              Participación
            </h3>

            <p>
              Abrimos espacios para que las voces de la comunidad
              hagan parte de las narrativas del territorio.
            </p>

          </article>


          <article class="principle-card">

            <span>04</span>

            <h3>
              Territorio
            </h3>

            <p>
              Entendemos el territorio como un espacio de cultura,
              organización, encuentro y transformación.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- ================================
         CIERRE
    ================================= -->

    <section class="about-ending">

      <div class="container">

        <h2>
          Nuestras voces,
          <span>nuestro territorio.</span>
        </h2>

        <p>
          ASHÉ apuesta por una comunicación comunitaria que permita
          contar nuestras realidades desde nuestras propias voces.
        </p>

        <a href="/" class="back-button">
          <span>←</span>
          Volver al inicio
        </a>

      </div>

    </section>

  </main>

</LayoutBase>


<style>

/* ================================
   GENERAL
================================= */

.about-page {

  background: #F7F4ED;

  color: #1B1B1B;
}


.container {

  width: min(1000px, calc(100% - 40px));

  margin: 0 auto;
}


.section-label {

  display: block;

  color: #A8572B;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


/* ================================
   HERO
================================= */

.about-hero {

  padding: 100px 20px 90px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.about-hero h1 {

  margin: 20px 0 15px;

  font-size: clamp(3.5rem, 9vw, 7rem);

  line-height: 0.9;

  letter-spacing: -4px;
}


.about-hero h1 span {

  display: block;

  color: #C8A24A;
}


.about-hero p {

  margin: 30px 0 0;

  color: rgba(247,244,237,0.7);

  font-size: 1.1rem;

  font-style: italic;
}


/* ================================
   SECCIÓN
================================= */

.about-section {

  padding: 100px 20px;
}


.about-grid {

  display: grid;

  grid-template-columns: 0.8fr 1.2fr;

  gap: 80px;
}


.about-intro h2 {

  margin: 18px 0 0;

  font-size: clamp(2rem, 4vw, 3.2rem);

  line-height: 1.1;

  letter-spacing: -1px;
}


.about-text {

  font-size: 1.05rem;

  line-height: 1.85;

  color: #444;
}


.about-text p {

  margin: 0 0 25px;
}


/* ================================
   FRASE
================================= */

.about-quote {

  padding: 80px 20px;

  background: #A8572B;

  color: #F7F4ED;

  text-align: center;
}


.quote-line {

  width: 60px;

  height: 3px;

  margin: 0 auto 25px;

  background: #C8A24A;
}


.about-quote h2 {

  margin: 0;

  font-size: clamp(3rem, 7vw, 5rem);

  letter-spacing: 4px;
}


.about-quote p {

  margin: 15px 0 0;

  color: rgba(247,244,237,0.8);

  font-size: 1.05rem;
}


/* ================================
   MISIÓN Y VISIÓN
================================= */

.mission-section {

  background: #F7F4ED;
}


.section-heading {

  margin-bottom: 50px;
}


.section-heading h2 {

  margin: 15px 0 0;

  font-size: clamp(2.3rem, 5vw, 3.8rem);

  line-height: 1;
}


.mission-grid {

  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 25px;
}


.mission-card {

  position: relative;

  overflow: hidden;

  padding: 40px;

  min-height: 350px;

  border-radius: 18px;

  background: white;

  border: 1px solid rgba(27,27,27,0.07);

  box-shadow:
    0 10px 30px rgba(27,27,27,0.05);
}


.mission-card-dark {

  background: #1B1B1B;

  color: #F7F4ED;
}


.mission-number {

  position: absolute;

  top: 25px;

  right: 30px;

  color: #C8A24A;

  font-size: 0.75rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.mission-label {

  display: inline-block;

  margin-bottom: 20px;

  color: #A8572B;

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.mission-card-dark .mission-label {

  color: #C8A24A;
}


.mission-card h3 {

  margin: 0 0 20px;

  font-size: 1.7rem;

  line-height: 1.15;
}


.mission-card p {

  margin: 0;

  color: #666;

  font-size: 0.97rem;

  line-height: 1.75;
}


.mission-card-dark p {

  color: rgba(247,244,237,0.7);
}


/* ================================
   PRINCIPIOS
================================= */

.principles-section {

  padding: 100px 20px;

  background: white;
}


.section-heading.center {

  max-width: 700px;

  margin: 0 auto 55px;

  text-align: center;
}


.section-heading.center p {

  margin: 22px auto 0;

  color: #666;

  line-height: 1.7;
}


.principles-grid {

  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 15px;
}


.principle-card {

  padding: 30px;

  border: 1px solid rgba(27,27,27,0.08);

  border-radius: 14px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}


.principle-card:hover {

  transform: translateY(-5px);

  box-shadow:
    0 12px 30px rgba(27,27,27,0.07);
}


.principle-card > span {

  color: #A8572B;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.principle-card h3 {

  margin: 15px 0 10px;

  font-size: 1.25rem;
}


.principle-card p {

  margin: 0;

  color: #666;

  font-size: 0.9rem;

  line-height: 1.65;
}


/* ================================
   CIERRE
================================= */

.about-ending {

  padding: 100px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.about-ending h2 {

  max-width: 750px;

  margin: 0 auto;

  font-size: clamp(2.5rem, 6vw, 4.5rem);

  line-height: 1;

  letter-spacing: -2px;
}


.about-ending h2 span {

  display: block;

  color: #C8A24A;
}


.about-ending p {

  max-width: 600px;

  margin: 25px auto 0;

  color: rgba(247,244,237,0.65);

  line-height: 1.7;
}


.back-button {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  margin-top: 35px;

  padding: 14px 22px;

  border: 1px solid rgba(247,244,237,0.25);

  border-radius: 30px;

  color: #F7F4ED;

  font-size: 0.85rem;

  font-weight: 700;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}


.back-button:hover {

  transform: translateY(-3px);

  border-color: #C8A24A;

  color: #C8A24A;
}


/* ================================
   RESPONSIVE
================================= */

@media (max-width: 800px) {

  .about-hero {

    padding: 75px 20px;
  }


  .about-section {

    padding: 75px 20px;
  }


  .about-grid {

    grid-template-columns: 1fr;

    gap: 35px;
  }


  .mission-grid {

    grid-template-columns: 1fr;
  }


  .principles-grid {

    grid-template-columns: repeat(2, 1fr);
  }

}


@media (max-width: 500px) {

  .container {

    width: min(100% - 30px, 1000px);
  }


  .about-hero h1 {

    letter-spacing: -2px;
  }


  .principles-grid {

    grid-template-columns: 1fr;
  }


  .mission-card {

    padding: 30px;

    min-height: auto;
  }

}

</style>