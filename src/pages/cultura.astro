---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Cultura y Estética">

  <!-- ================================
       HERO
  ================================= -->

  <section class="cultura-hero">

    <div class="hero-circle"></div>

    <div class="container">

      <span class="section-label">
        ARTE · IDENTIDAD · EXPRESIÓN
      </span>

      <h1>
        Cultura
        <span>y Estética</span>
      </h1>

      <p>
        Expresiones, saberes y formas de identidad que mantienen viva
        la riqueza cultural de las comunidades afrodescendientes.
      </p>

    </div>

  </section>


  <!-- ================================
       INTRODUCCIÓN
  ================================= -->

  <section class="cultura-intro">

    <div class="container intro-grid">

      <div>

        <span class="small-label">
          NUESTRA CULTURA
        </span>

        <h2>
          Nuestra identidad
          <span>también se expresa.</span>
        </h2>

      </div>

      <div class="intro-text">

        <p>
          La cultura afrodescendiente se expresa de muchas maneras:
          en la música, la danza, la gastronomía, el arte, la estética,
          la palabra y las diferentes formas de encontrarnos como comunidad.
        </p>

        <p>
          En ASHÉ queremos visibilizar estas expresiones y reconocer
          la cultura como una parte fundamental de nuestra memoria,
          nuestra identidad y nuestra relación con el territorio.
        </p>

      </div>

    </div>

  </section>


  <!-- ================================
       EXPRESIONES CULTURALES
  ================================= -->

  <section class="expresiones">

    <div class="container">

      <div class="section-header">

        <div>

          <span class="section-label">
            EXPRESIONES CULTURALES
          </span>

          <h2>
            Cultura que
            <span>se vive.</span>
          </h2>

        </div>

        <p>
          Historias, conocimientos y expresiones que hacen parte
          de la diversidad cultural afrodescendiente.
        </p>

      </div>


      <div class="culture-grid">

        <!-- MÚSICA -->

        <article class="culture-card culture-dark">

          <div class="card-number">
            01
          </div>

          <div class="culture-icon">
            ♪
          </div>

          <h3>
            Música
          </h3>

          <p>
            Ritmos, sonidos y expresiones musicales que acompañan
            nuestras historias, celebraciones y procesos comunitarios.
          </p>

          <span class="card-word">
            SONIDO
          </span>

        </article>


        <!-- DANZA -->

        <article class="culture-card">

          <div class="card-number">
            02
          </div>

          <div class="culture-icon">
            ◇
          </div>

          <h3>
            Danza
          </h3>

          <p>
            El movimiento como forma de expresión, memoria,
            encuentro y transmisión cultural entre generaciones.
          </p>

          <span class="card-word">
            MOVIMIENTO
          </span>

        </article>


        <!-- GASTRONOMÍA -->

        <article class="culture-card">

          <div class="card-number">
            03
          </div>

          <div class="culture-icon">
            ✦
          </div>

          <h3>
            Gastronomía
          </h3>

          <p>
            Sabores, preparaciones y conocimientos culinarios que
            conectan la alimentación con la memoria y la tradición.
          </p>

          <span class="card-word">
            SABOR
          </span>

        </article>


        <!-- ARTE -->

        <article class="culture-card culture-dark">

          <div class="card-number">
            04
          </div>

          <div class="culture-icon">
            ✎
          </div>

          <h3>
            Arte
          </h3>

          <p>
            Creaciones y expresiones artísticas que permiten narrar
            experiencias, fortalecer identidades y transformar miradas.
          </p>

          <span class="card-word">
            CREACIÓN
          </span>

        </article>


        <!-- CABELLO -->

        <article class="culture-card">

          <div class="card-number">
            05
          </div>

          <div class="culture-icon">
            ✦
          </div>

          <h3>
            Cabello afro
          </h3>

          <p>
            Peinados, estilos y formas de expresión que hacen del
            cabello un espacio de identidad, memoria y reconocimiento.
          </p>

          <span class="card-word">
            IDENTIDAD
          </span>

        </article>


        <!-- MODA -->

        <article class="culture-card">

          <div class="card-number">
            06
          </div>

          <div class="culture-icon">
            ◈
          </div>

          <h3>
            Moda y estética
          </h3>

          <p>
            Vestuario, accesorios, turbantes y diferentes formas
            de expresar nuestra identidad y creatividad.
          </p>

          <span class="card-word">
            ESTILO
          </span>

        </article>

      </div>

    </div>

  </section>


  <!-- ================================
       ESTÉTICA AFRO
  ================================= -->

  <section class="estetica">

    <div class="container estetica-grid">

      <div class="estetica-visual">

        <div class="visual-circle visual-one"></div>
        <div class="visual-circle visual-two"></div>

        <div class="visual-text">

          <span>ASHÉ</span>

          <small>
            IDENTIDAD · ESTÉTICA · CULTURA
          </small>

        </div>

      </div>


      <div class="estetica-content">

        <span class="section-label">
          ESTÉTICA AFRO
        </span>

        <h2>
          Llevar nuestra identidad
          <span>también es contar una historia.</span>
        </h2>

        <p>
          La estética afro es una forma de expresión y reconocimiento.
          El cabello, los peinados, los turbantes, la moda y los
          accesorios pueden convertirse en espacios para celebrar
          nuestras raíces y reafirmar nuestra identidad.
        </p>

        <p>
          Desde ASHÉ queremos abrir espacios para conocer las historias
          detrás de estas expresiones y reconocer a las personas que
          hacen de la estética una herramienta de identidad y creatividad.
        </p>

      </div>

    </div>

  </section>


  <!-- ================================
       FRASE
  ================================= -->

  <section class="cultura-frase">

    <div class="container">

      <span>
        ASHÉ
      </span>

      <h2>
        Nuestra cultura no solamente
        <strong>se recuerda: se vive.</strong>
      </h2>

      <p>
        ARTE · MÚSICA · DANZA · GASTRONOMÍA · ESTÉTICA
      </p>

    </div>

  </section>


  <!-- ================================
       CIERRE
  ================================= -->

  <section class="cultura-cierre">

    <div class="container cierre-grid">

      <div>

        <span class="section-label">
          CULTURA VIVA
        </span>

        <h2>
          Historias que
          <span>merecen ser contadas.</span>
        </h2>

      </div>

      <div>

        <p>
          Cada expresión cultural tiene una historia detrás.
          ASHÉ busca acercarse a esas historias y darles un espacio
          dentro de nuestras propias narrativas.
        </p>

        <a href="/memoria" class="button">
          Conocer nuestras historias
          <span>→</span>
        </a>

      </div>

    </div>

  </section>

</LayoutBase>


<style>

/* =================================
   GENERAL
================================= */

.container {

  width: min(1000px, calc(100% - 40px));

  margin: 0 auto;
}


.section-label {

  display: block;

  margin-bottom: 18px;

  color: #C8A24A;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


/* =================================
   HERO
================================= */

.cultura-hero {

  position: relative;

  min-height: 520px;

  display: flex;

  align-items: center;

  overflow: hidden;

  background: #1B1B1B;

  color: #F7F4ED;
}


.cultura-hero::before {

  content: "";

  position: absolute;

  width: 600px;

  height: 600px;

  right: -250px;

  top: -250px;

  border:
    1px solid rgba(200, 162, 74, 0.18);

  border-radius: 50%;

  box-shadow:
    0 0 0 80px rgba(200, 162, 74, 0.025),
    0 0 0 160px rgba(200, 162, 74, 0.015);
}


.hero-circle {

  position: absolute;

  width: 300px;

  height: 300px;

  left: -160px;

  bottom: -160px;

  border:
    1px solid rgba(168, 87, 43, 0.35);

  border-radius: 50%;
}


.cultura-hero .container {

  position: relative;

  z-index: 2;

  padding: 80px 0;
}


.cultura-hero h1 {

  max-width: 800px;

  margin: 0;

  font-size: clamp(3.8rem, 9vw, 7rem);

  line-height: 0.92;

  letter-spacing: -4px;
}


.cultura-hero h1 span {

  display: block;

  color: #C8A24A;
}


.cultura-hero p {

  max-width: 650px;

  margin: 35px 0 0;

  color: rgba(247, 244, 237, 0.72);

  font-size: 1.08rem;

  line-height: 1.75;
}


/* =================================
   INTRO
================================= */

.cultura-intro {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.intro-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}


.small-label {

  color: #A8572B;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.intro-grid h2 {

  margin: 18px 0 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.intro-grid h2 span {

  display: block;

  color: #A8572B;
}


.intro-text {

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


.intro-text p {

  margin: 0 0 20px;
}


/* =================================
   EXPRESIONES
================================= */

.expresiones {

  padding: 110px 20px;

  background: #FFFFFF;

  color: #1B1B1B;
}


.section-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 50px;

  margin-bottom: 55px;
}


.section-header h2 {

  margin: 0;

  font-size: clamp(2.6rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.section-header h2 span {

  color: #A8572B;
}


.section-header > p {

  max-width: 400px;

  margin: 0;

  color: #777;

  line-height: 1.7;
}


/* =================================
   TARJETAS
================================= */

.culture-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;
}


.culture-card {

  position: relative;

  min-height: 320px;

  padding: 32px;

  overflow: hidden;

  background: #F7F4ED;

  border:
    1px solid rgba(27, 27, 27, 0.07);

  border-radius: 16px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.culture-card:hover {

  transform: translateY(-5px);

  border-color:
    rgba(200, 162, 74, 0.5);

  box-shadow:
    0 18px 35px rgba(27, 27, 27, 0.08);
}


.culture-card.culture-dark {

  background: #1B1B1B;

  color: #F7F4ED;
}


.card-number {

  position: absolute;

  top: 22px;

  right: 25px;

  color: rgba(27, 27, 27, 0.25);

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.culture-dark .card-number {

  color:
    rgba(247, 244, 237, 0.25);
}


.culture-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 48px;

  height: 48px;

  margin-bottom: 28px;

  color: #C8A24A;

  border:
    1px solid rgba(200, 162, 74, 0.45);

  border-radius: 50%;

  font-size: 1.2rem;
}


.culture-card h3 {

  margin: 0 0 15px;

  font-size: 1.5rem;

  line-height: 1.1;
}


.culture-card p {

  margin: 0;

  color: #777;

  font-size: 0.9rem;

  line-height: 1.7;
}


.culture-dark p {

  color:
    rgba(247, 244, 237, 0.65);
}


.card-word {

  position: absolute;

  left: 32px;

  bottom: 25px;

  color: #A8572B;

  font-size: 0.6rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.culture-dark .card-word {

  color: #C8A24A;
}


/* =================================
   ESTÉTICA
================================= */

.estetica {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.estetica-grid {

  display: grid;

  grid-template-columns: 0.9fr 1.1fr;

  gap: 80px;

  align-items: center;
}


/* Visual */

.estetica-visual {

  position: relative;

  min-height: 480px;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #1B1B1B,
      #A8572B
    );
}


.visual-circle {

  position: absolute;

  border:
    1px solid rgba(200, 162, 74, 0.25);

  border-radius: 50%;
}


.visual-one {

  width: 270px;

  height: 270px;
}


.visual-two {

  width: 430px;

  height: 430px;
}


.visual-text {

  position: relative;

  z-index: 2;

  text-align: center;
}


.visual-text span {

  display: block;

  color: #C8A24A;

  font-size: clamp(3.5rem, 7vw, 6rem);

  font-weight: 800;

  letter-spacing: 4px;
}


.visual-text small {

  display: block;

  margin-top: 15px;

  color:
    rgba(247, 244, 237, 0.6);

  font-size: 0.58rem;

  letter-spacing: 2px;
}


/* Texto */

.estetica-content {

  color: #1B1B1B;
}


.estetica-content .section-label {

  color: #A8572B;
}


.estetica-content h2 {

  margin: 0 0 28px;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.estetica-content h2 span {

  display: block;

  color: #A8572B;
}


.estetica-content p {

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


/* =================================
   FRASE
================================= */

.cultura-frase {

  padding: 120px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.cultura-frase span {

  display: block;

  margin-bottom: 25px;

  color: #C8A24A;

  font-size: 0.8rem;

  font-weight: 800;

  letter-spacing: 5px;
}


.cultura-frase h2 {

  max-width: 850px;

  margin: 0 auto;

  font-size: clamp(2rem, 4vw, 3.5rem);

  line-height: 1.15;

  letter-spacing: -1px;
}


.cultura-frase strong {

  display: block;

  color: #C8A24A;
}


.cultura-frase p {

  margin: 30px 0 0;

  color:
    rgba(247, 244, 237, 0.45);

  font-size: 0.68rem;

  letter-spacing: 3px;
}


/* =================================
   CIERRE
================================= */

.cultura-cierre {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.cierre-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}


.cierre-grid h2 {

  margin: 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.cierre-grid h2 span {

  display: block;

  color: #A8572B;
}


.cierre-grid p {

  margin: 0;

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


.button {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  margin-top: 25px;

  padding: 14px 22px;

  background: #C8A24A;

  color: #1B1B1B;

  border-radius: 25px;

  font-size: 0.82rem;

  font-weight: 800;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}


.button:hover {

  transform: translateY(-3px);

  background: #D8B65F;
}


.button span {

  font-size: 1.1rem;
}


/* =================================
   RESPONSIVE
================================= */

@media (max-width: 800px) {

  .cultura-hero {

    min-height: 450px;
  }


  .cultura-hero h1 {

    letter-spacing: -2px;
  }


  .intro-grid,
  .estetica-grid,
  .cierre-grid {

    grid-template-columns: 1fr;

    gap: 40px;
  }


  .section-header {

    display: block;
  }


  .section-header > p {

    margin-top: 20px;
  }


  .culture-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }


  .estetica-visual {

    min-height: 350px;
  }

}


@media (max-width: 550px) {

  .cultura-hero .container {

    padding: 60px 0;
  }


  .cultura-intro,
  .expresiones,
  .estetica,
  .cultura-cierre {

    padding: 80px 20px;
  }


  .culture-grid {

    grid-template-columns: 1fr;
  }


  .culture-card {

    min-height: 290px;

    padding: 28px;
  }


  .cultura-frase {

    padding: 90px 20px;
  }


  .cultura-frase h2 {

    font-size: 2rem;
  }


  .estetica-visual {

    min-height: 300px;
  }

}

</style>