---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase
  title="Actualidad Afro"
  description="Noticias, historias, voces y acontecimientos de las comunidades afrodescendientes en Bogotá."
>

  <main class="actualidad">

    <!-- =================================
         HERO
    ================================== -->

    <section class="actualidad-hero">

      <div class="container">

        <span class="section-label">
          ACTUALIDAD AFRO
        </span>

        <h1>
          Lo que pasa
          <span>en nuestro territorio.</span>
        </h1>

        <p>
          Noticias, historias, voces y acontecimientos de interés
          para las comunidades afrodescendientes en Bogotá.
        </p>

      </div>

    </section>


    <!-- =================================
         NOTICIA DESTACADA
    ================================== -->

    <section class="featured-news">

      <div class="container">

        <div class="section-top">

          <div>
            <span class="small-label">
              DESTACADA
            </span>

            <h2>
              Historias que
              <span>merecen ser contadas.</span>
            </h2>
          </div>

          <p>
            Un espacio para conocer las experiencias, iniciativas
            y acontecimientos que hacen parte de nuestros territorios.
          </p>

        </div>


        <article class="main-news">

          <div class="news-image">

            <div class="image-placeholder">

              <span>
                ASHÉ
              </span>

              <small>
                PRÓXIMAMENTE
              </small>

            </div>

            <span class="news-number">
              01
            </span>

          </div>


          <div class="main-news-content">

            <div class="news-meta">

              <span>
                ACTUALIDAD
              </span>

              <span>•</span>

              <span>
                ASHÉ
              </span>

            </div>

            <h3>
              Próximamente encontrarás
              aquí nuestras historias.
            </h3>

            <p>
              Estamos preparando este espacio para compartir
              noticias, entrevistas, crónicas y contenidos sobre
              las comunidades afrodescendientes y sus procesos
              en Bogotá.
            </p>

            <span class="coming">
              CONTENIDO EN CONSTRUCCIÓN
            </span>

          </div>

        </article>

      </div>

    </section>


    <!-- =================================
         CATEGORÍAS
    ================================== -->

    <section class="news-categories">

      <div class="container">

        <div class="section-heading">

          <span class="section-label">
            EXPLORA
          </span>

          <h2>
            Nuestra
            <span>actualidad.</span>
          </h2>

        </div>


        <div class="categories-grid">

          <article class="category-card">

            <span class="category-number">
              01
            </span>

            <div class="category-icon">
              N
            </div>

            <h3>
              Noticias
            </h3>

            <p>
              Información sobre acontecimientos, iniciativas y
              hechos de interés para nuestras comunidades.
            </p>

          </article>


          <article class="category-card dark">

            <span class="category-number">
              02
            </span>

            <div class="category-icon">
              E
            </div>

            <h3>
              Entrevistas
            </h3>

            <p>
              Conversaciones con líderes, artistas, jóvenes,
              gestores y personas que aportan al territorio.
            </p>

          </article>


          <article class="category-card">

            <span class="category-number">
              03
            </span>

            <div class="category-icon">
              C
            </div>

            <h3>
              Crónicas
            </h3>

            <p>
              Historias narradas desde las experiencias y
              realidades de nuestras comunidades.
            </p>

          </article>


          <article class="category-card">

            <span class="category-number">
              04
            </span>

            <div class="category-icon">
              T
            </div>

            <h3>
              Territorio
            </h3>

            <p>
              Procesos comunitarios, participación y acontecimientos
              que transforman nuestros territorios.
            </p>

          </article>


          <article class="category-card dark">

            <span class="category-number">
              05
            </span>

            <div class="category-icon">
              J
            </div>

            <h3>
              Juventudes
            </h3>

            <p>
              Voces, iniciativas y experiencias de jóvenes
              afrodescendientes.
            </p>

          </article>


          <article class="category-card">

            <span class="category-number">
              06
            </span>

            <div class="category-icon">
              C
            </div>

            <h3>
              Cultura
            </h3>

            <p>
              Arte, música, danza, gastronomía y otras expresiones
              de nuestra identidad cultural.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =================================
         MENSAJE EDITORIAL
    ================================== -->

    <section class="editorial">

      <div class="container editorial-content">

        <span>
          DESDE EL TERRITORIO
        </span>

        <h2>
          No solo contamos
          <strong>lo que sucede.</strong>
        </h2>

        <p>
          Escuchamos, acompañamos y damos espacio a las voces
          que construyen comunidad.
        </p>

      </div>

    </section>


    <!-- =================================
         PRÓXIMAMENTE
    ================================== -->

    <section class="coming-section">

      <div class="container coming-box">

        <div class="coming-icon">
          +
        </div>

        <div>

          <span>
            PRÓXIMAMENTE
          </span>

          <h2>
            Nuevas historias,
            nuevas voces.
          </h2>

          <p>
            ASHÉ está preparando nuevos contenidos periodísticos
            y comunitarios. Muy pronto podrás encontrar aquí
            nuestras primeras publicaciones.
          </p>

        </div>

      </div>

    </section>


    <!-- =================================
         CIERRE
    ================================== -->

    <section class="actualidad-ending">

      <div class="container">

        <span>
          ASHÉ
        </span>

        <h2>
          La actualidad también
          <strong>construye memoria.</strong>
        </h2>

        <p>
          Información · Comunidad · Cultura · Territorio
        </p>

      </div>

    </section>

  </main>

</LayoutBase>


<style>

/* =================================
   GENERAL
================================= */

.actualidad {

  --black: #1B1B1B;
  --gold: #C8A24A;
  --terracotta: #A8572B;
  --cream: #F7F4ED;
  --white: #FFFFFF;
  --gray: #666;

  background: var(--cream);

  color: var(--black);
}


.container {

  width: min(1000px, calc(100% - 40px));

  margin: 0 auto;
}


/* =================================
   HERO
================================= */

.actualidad-hero {

  min-height: 470px;

  display: flex;

  align-items: center;

  position: relative;

  overflow: hidden;

  background: var(--black);

  color: var(--cream);
}


.actualidad-hero::before {

  content: "";

  position: absolute;

  width: 600px;
  height: 600px;

  right: -250px;
  top: -260px;

  border:
    1px solid rgba(200,162,74,0.2);

  border-radius: 50%;

  box-shadow:
    0 0 0 80px rgba(200,162,74,0.025),
    0 0 0 160px rgba(200,162,74,0.015);
}


.actualidad-hero::after {

  content: "";

  position: absolute;

  width: 250px;
  height: 250px;

  left: -130px;
  bottom: -130px;

  border:
    1px solid rgba(168,87,43,0.35);

  border-radius: 50%;
}


.actualidad-hero .container {

  position: relative;

  z-index: 2;

  padding: 80px 0;
}


.section-label {

  display: block;

  margin-bottom: 18px;

  color: var(--gold);

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.actualidad-hero h1 {

  max-width: 850px;

  margin: 0;

  font-size:
    clamp(3.5rem, 8vw, 6.5rem);

  line-height: 0.93;

  letter-spacing: -4px;
}


.actualidad-hero h1 span {

  display: block;

  color: var(--gold);
}


.actualidad-hero p {

  max-width: 650px;

  margin: 30px 0 0;

  color:
    rgba(247,244,237,0.7);

  font-size: 1.08rem;

  line-height: 1.75;
}


/* =================================
   DESTACADA
================================= */

.featured-news {

  padding: 110px 20px;

  background: var(--cream);
}


.section-top {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 50px;

  margin-bottom: 50px;
}


.small-label {

  display: block;

  margin-bottom: 15px;

  color: var(--terracotta);

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.section-top h2 {

  margin: 0;

  font-size:
    clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.section-top h2 span {

  display: block;

  color: var(--terracotta);
}


.section-top > p {

  max-width: 400px;

  margin: 0;

  color: var(--gray);

  line-height: 1.7;
}


/* =================================
   NOTICIA PRINCIPAL
================================= */

.main-news {

  display: grid;

  grid-template-columns: 1fr 1fr;

  min-height: 450px;

  overflow: hidden;

  border-radius: 18px;

  background: var(--black);

  box-shadow:
    0 20px 45px rgba(27,27,27,0.12);
}


.news-image {

  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 40%,
      rgba(200,162,74,0.2),
      transparent 35%
    ),
    linear-gradient(
      145deg,
      #242424,
      #A8572B
    );
}


.news-image::before,
.news-image::after {

  content: "";

  position: absolute;

  width: 330px;
  height: 330px;

  border:
    1px solid rgba(200,162,74,0.2);

  border-radius: 50%;
}


.news-image::after {

  width: 500px;
  height: 500px;
}


.image-placeholder {

  position: relative;

  z-index: 2;

  display: flex;

  flex-direction: column;

  align-items: center;
}


.image-placeholder span {

  color: var(--gold);

  font-size:
    clamp(4rem, 8vw, 7rem);

  font-weight: 800;

  letter-spacing: 5px;
}


.image-placeholder small {

  margin-top: 15px;

  color:
    rgba(247,244,237,0.6);

  font-size: 0.58rem;

  letter-spacing: 3px;
}


.news-number {

  position: absolute;

  top: 25px;
  left: 28px;

  color:
    rgba(247,244,237,0.4);

  font-size: 0.75rem;

  font-weight: 800;

  letter-spacing: 2px;
}


/* CONTENIDO */

.main-news-content {

  display: flex;

  flex-direction: column;

  justify-content: center;

  padding: 55px;
}


.news-meta {

  display: flex;

  gap: 10px;

  color: var(--gold);

  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 1.5px;
}


.main-news-content h3 {

  margin: 22px 0 20px;

  color: var(--cream);

  font-size:
    clamp(2rem, 4vw, 3.1rem);

  line-height: 1.08;

  letter-spacing: -1px;
}


.main-news-content p {

  max-width: 530px;

  margin: 0;

  color:
    rgba(247,244,237,0.65);

  font-size: 0.95rem;

  line-height: 1.75;
}


.coming {

  display: inline-block;

  margin-top: 30px;

  color: var(--gold);

  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 2px;
}


/* =================================
   CATEGORÍAS
================================= */

.news-categories {

  padding: 110px 20px;

  background: var(--white);
}


.section-heading {

  margin-bottom: 50px;
}


.section-heading h2 {

  margin: 0;

  font-size:
    clamp(2.6rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.section-heading h2 span {

  color: var(--terracotta);
}


.categories-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;
}


.category-card {

  position: relative;

  min-height: 290px;

  padding: 30px;

  overflow: hidden;

  border:
    1px solid rgba(27,27,27,0.07);

  border-radius: 15px;

  background: var(--cream);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.category-card:hover {

  transform: translateY(-5px);

  border-color:
    rgba(200,162,74,0.5);

  box-shadow:
    0 15px 30px rgba(27,27,27,0.08);
}


.category-card.dark {

  background: var(--black);

  color: var(--cream);
}


.category-number {

  position: absolute;

  top: 20px;
  right: 22px;

  color:
    rgba(27,27,27,0.25);

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.dark .category-number {

  color:
    rgba(247,244,237,0.25);
}


.category-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 48px;
  height: 48px;

  margin-bottom: 28px;

  border:
    1px solid rgba(200,162,74,0.45);

  border-radius: 50%;

  color: var(--gold);

  font-size: 0.9rem;

  font-weight: 800;
}


.category-card h3 {

  margin: 0 0 12px;

  font-size: 1.45rem;
}


.category-card p {

  margin: 0;

  color: #777;

  font-size: 0.9rem;

  line-height: 1.7;
}


.category-card.dark p {

  color:
    rgba(247,244,237,0.65);
}


/* =================================
   EDITORIAL
================================= */

.editorial {

  padding: 120px 20px;

  background: var(--terracotta);

  color: white;

  text-align: center;
}


.editorial-content {

  max-width: 850px;

  margin: 0 auto;
}


.editorial-content > span {

  color: #F2D58B;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.editorial h2 {

  margin: 20px 0;

  font-size:
    clamp(2.5rem, 5vw, 4rem);

  line-height: 1.05;

  letter-spacing: -2px;
}


.editorial h2 strong {

  display: block;

  color: #F2D58B;
}


.editorial p {

  margin: 0;

  color:
    rgba(255,255,255,0.8);

  font-size: 1.05rem;

  line-height: 1.7;
}


/* =================================
   PRÓXIMAMENTE
================================= */

.coming-section {

  padding: 90px 20px;

  background: var(--cream);
}


.coming-box {

  display: grid;

  grid-template-columns: 65px 1fr;

  gap: 30px;

  padding: 45px;

  background: white;

  border-left:
    4px solid var(--gold);

  border-radius: 15px;

  box-shadow:
    0 10px 30px rgba(27,27,27,0.05);
}


.coming-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 55px;
  height: 55px;

  border-radius: 50%;

  background:
    rgba(200,162,74,0.12);

  color: var(--terracotta);

  font-size: 1.5rem;

  font-weight: 800;
}


.coming-box span {

  color: var(--terracotta);

  font-size: 0.68rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.coming-box h2 {

  margin: 12px 0;

  font-size:
    clamp(1.8rem, 4vw, 2.7rem);

  line-height: 1.1;
}


.coming-box p {

  max-width: 700px;

  margin: 0;

  color: var(--gray);

  line-height: 1.75;
}


/* =================================
   CIERRE
================================= */

.actualidad-ending {

  padding: 110px 20px;

  background: var(--black);

  color: var(--cream);

  text-align: center;
}


.actualidad-ending span {

  color: var(--gold);

  font-size: 0.8rem;

  font-weight: 800;

  letter-spacing: 5px;
}


.actualidad-ending h2 {

  max-width: 800px;

  margin: 25px auto;

  font-size:
    clamp(2.2rem, 5vw, 3.8rem);

  line-height: 1.1;

  letter-spacing: -1px;
}


.actualidad-ending h2 strong {

  display: block;

  color: var(--gold);
}


.actualidad-ending p {

  margin: 0;

  color:
    rgba(247,244,237,0.45);

  font-size: 0.68rem;

  letter-spacing: 3px;
}


/* =================================
   RESPONSIVE
================================= */

@media (max-width: 800px) {

  .actualidad-hero {

    min-height: 420px;
  }


  .section-top {

    display: block;
  }


  .section-top > p {

    margin-top: 20px;
  }


  .main-news {

    grid-template-columns: 1fr;
  }


  .news-image {

    min-height: 300px;
  }


  .main-news-content {

    padding: 35px 28px;
  }


  .categories-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

}


@media (max-width: 550px) {

  .actualidad-hero .container {

    padding: 60px 0;
  }


  .featured-news,
  .news-categories,
  .coming-section {

    padding: 80px 20px;
  }


  .categories-grid {

    grid-template-columns: 1fr;
  }


  .category-card {

    min-height: auto;

    padding: 28px;
  }


  .editorial {

    padding: 90px 20px;
  }


  .coming-box {

    grid-template-columns: 1fr;

    padding: 30px;
  }


  .actualidad-ending {

    padding: 90px 20px;
  }

}

</style>