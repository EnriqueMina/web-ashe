---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase
  title="Actualidad Afro"
  description="Noticias, historias, voces y acontecimientos de las comunidades afrodescendientes en Bogotá."
>

  <main class="actualidad">

    <!-- ==========================================
         HERO
    =========================================== -->

    <section class="actualidad-hero">

      <div class="container">

        <span class="section-label">
          ACTUALIDAD AFRO
        </span>

        <h1>
          Lo que pasa
          <span>en nuestro territorio.</span>
        </h1>

        <p>
          Noticias, historias, voces y acontecimientos de interés
          para las comunidades afrodescendientes en Bogotá.
        </p>

      </div>

    </section>


    <!-- ==========================================
         NOTICIA DESTACADA
    =========================================== -->

    <section class="featured-news">

      <div class="container">

        <div class="section-top">

          <div>

            <span class="small-label">
              DESTACADA
            </span>

            <h2>
              Historias que
              <span>merecen ser contadas.</span>
            </h2>

          </div>

          <p>
            Un espacio para conocer las experiencias, iniciativas
            y acontecimientos que hacen parte de nuestros territorios.
          </p>

        </div>


        <!-- ======================================
             TARJETA DE LA NOTICIA
        ======================================= -->

        <article class="main-news">


          <!-- IMAGEN DE PORTADA -->

          <a
            href="/actualidad/articulo-terremoto"
            class="news-image"
            aria-label="Leer artículo sobre el terremoto del 10 de agosto"
          >

            <img
              src="/images/imagen3.jpeg"
              alt="Daños ocasionados por el terremoto en el Pacífico colombiano"
            />

            <span class="news-number">
              01
            </span>

          </a>


          <!-- INFORMACIÓN DE LA NOTICIA -->

          <div class="main-news-content">

            <div class="news-meta">

              <span>
                OPINIÓN / ANÁLISIS
              </span>

              <span>
                •
              </span>

              <span>
                ASHÉ
              </span>

            </div>


            <h3>
              El terremoto del 10 de agosto:
              la urgencia de mirar hacia el
              Pacífico tras el sismo
            </h3>


            <p>
              El impacto del terremoto de magnitud 7.4 dejó en
              evidencia el racismo estructural, la brecha en la
              infraestructura y la fuerza de la solidaridad
              comunitaria en el Chocó y Buenaventura.
            </p>


            <span class="author">
              Por:
              <strong>Maleja Banguera</strong>
            </span>


            <a
              href="/actualidad/articulo-terremoto"
              class="read-button"
            >
              LEER ARTÍCULO
              <span>→</span>
            </a>

          </div>

        </article>

      </div>

    </section>


    <!-- ==========================================
         CATEGORÍAS
    =========================================== -->

    <section class="news-categories">

      <div class="container">

        <div class="section-heading">

          <span class="section-label">
            EXPLORA
          </span>

          <h2>
            Nuestra
            <span>actualidad.</span>
          </h2>

        </div>


        <div class="categories-grid">


          <!-- NOTICIAS -->

          <article class="category-card">

            <span class="category-number">
              01
            </span>

            <div class="category-icon">
              N
            </div>

            <h3>
              Noticias
            </h3>

            <p>
              Información sobre acontecimientos, iniciativas y
              hechos de interés para nuestras comunidades.
            </p>

          </article>


          <!-- ENTREVISTAS -->

          <article class="category-card dark">

            <span class="category-number">
              02
            </span>

            <div class="category-icon">
              E
            </div>

            <h3>
              Entrevistas
            </h3>

            <p>
              Conversaciones con líderes, artistas, jóvenes,
              gestores y personas que aportan al territorio.
            </p>

          </article>


          <!-- CRÓNICAS -->

          <article class="category-card">

            <span class="category-number">
              03
            </span>

            <div class="category-icon">
              C
            </div>

            <h3>
              Crónicas
            </h3>

            <p>
              Historias narradas desde las experiencias y
              realidades de nuestras comunidades.
            </p>

          </article>


          <!-- TERRITORIO -->

          <article class="category-card">

            <span class="category-number">
              04
            </span>

            <div class="category-icon">
              T
            </div>

            <h3>
              Territorio
            </h3>

            <p>
              Procesos comunitarios, participación y acontecimientos
              que transforman nuestros territorios.
            </p>

          </article>


          <!-- JUVENTUDES -->

          <article class="category-card dark">

            <span class="category-number">
              05
            </span>

            <div class="category-icon">
              J
            </div>

            <h3>
              Juventudes
            </h3>

            <p>
              Voces, iniciativas y experiencias de jóvenes
              afrodescendientes.
            </p>

          </article>


          <!-- CULTURA -->

          <article class="category-card">

            <span class="category-number">
              06
            </span>

            <div class="category-icon">
              C
            </div>

            <h3>
              Cultura
            </h3>

            <p>
              Arte, música, danza, gastronomía y otras expresiones
              de nuestra identidad cultural.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- ==========================================
         EDITORIAL
    =========================================== -->

    <section class="editorial">

      <div class="container editorial-content">

        <span>
          DESDE EL TERRITORIO
        </span>

        <h2>
          No solo contamos
          <strong>lo que sucede.</strong>
        </h2>

        <p>
          Escuchamos, acompañamos y damos espacio a las voces
          que construyen comunidad.
        </p>

      </div>

    </section>


    <!-- ==========================================
         PRÓXIMAMENTE
    =========================================== -->

    <section class="coming-section">

      <div class="container coming-box">

        <div class="coming-icon">
          +
        </div>

        <div>

          <span>
            PRÓXIMAMENTE
          </span>

          <h2>
            Nuevas historias,
            nuevas voces.
          </h2>

          <p>
            ASHÉ está preparando nuevos contenidos periodísticos
            y comunitarios. Muy pronto podrás encontrar aquí
            nuestras primeras publicaciones.
          </p>

        </div>

      </div>

    </section>


    <!-- ==========================================
         CIERRE
    =========================================== -->

    <section class="actualidad-ending">

      <div class="container">

        <span>
          ASHÉ
        </span>

        <h2>
          La actualidad también
          <strong>construye memoria.</strong>
        </h2>

        <p>
          Información · Comunidad · Cultura · Territorio
        </p>

      </div>

    </section>

  </main>

</LayoutBase>


<style>

/* ==================================================
   VARIABLES
================================================== */

.actualidad {

  --black: #1B1B1B;
  --gold: #C8A24A;
  --terracotta: #A8572B;
  --cream: #F7F4ED;
  --white: #FFFFFF;
  --gray: #666666;

  background: var(--cream);

  color: var(--black);
}


/* ==================================================
   CONTENEDOR
================================================== */

.container {

  width: min(1000px, calc(100% - 40px));

  margin: 0 auto;
}


/* ==================================================
   HERO
================================================== */

.actualidad-hero {

  min-height: 470px;

  display: flex;

  align-items: center;

  position: relative;

  overflow: hidden;

  background: var(--black);

  color: var(--cream);
}


.actualidad-hero::before {

  content: "";

  position: absolute;

  width: 600px;
  height: 600px;

  right: -250px;
  top: -260px;

  border: 1px solid rgba(200,162,74,0.2);

  border-radius: 50%;

  box-shadow:
    0 0 0 80px rgba(200,162,74,0.025),
    0 0 0 160px rgba(200,162,74,0.015);
}


.actualidad-hero::after {

  content: "";

  position: absolute;

  width: 250px;
  height: 250px;

  left: -130px;
  bottom: -130px;

  border: 1px solid rgba(168,87,43,0.35);

  border-radius: 50%;
}


.actualidad-hero .container {

  position: relative;

  z-index: 2;

  padding: 80px 0;
}


.section-label {

  display: block;

  margin-bottom: 18px;

  color: var(--gold);

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.actualidad-hero h1 {

  max-width: 850px;

  margin: 0;

  font-size: clamp(3.5rem, 8vw, 6.5rem);

  line-height: 0.93;

  letter-spacing: -4px;
}


.actualidad-hero h1 span {

  display: block;

  color: var(--gold);
}


.actualidad-hero p {

  max-width: 650px;

  margin: 30px 0 0;

  color: rgba(247,244,237,0.7);

  font-size: 1.08rem;

  line-height: 1.75;
}


/* ==================================================
   NOTICIA DESTACADA
================================================== */

.featured-news {

  padding: 110px 20px;

  background: var(--cream);
}


.section-top {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 50px;

  margin-bottom: 50px;
}


.small-label {

  display: block;

  margin-bottom: 15px;

  color: var(--terracotta);

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.section-top h2 {

  margin: 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.section-top h2 span {

  display: block;

  color: var(--terracotta);
}


.section-top > p {

  max-width: 400px;

  margin: 0;

  color: var(--gray);

  line-height: 1.7;
}


/* ==================================================
   TARJETA PRINCIPAL
================================================== */

/*
   IMPORTANTE:
   La tarjeta queda FIJA en 450px.
   Esto evita que el texto haga crecer
   toda la página.
*/

.main-news {

  display: grid;

  grid-template-columns: 1fr 1fr;

  width: 100%;

  height: 450px;

  min-height: 450px;

  max-height: 450px;

  overflow: hidden;

  border-radius: 18px;

  background: var(--black);

  box-shadow:
    0 20px 45px rgba(27,27,27,0.12);
}


/* ==================================================
   IMAGEN DE LA TARJETA
================================================== */

.news-image {

  position: relative;

  display: block;

  width: 100%;

  height: 450px;

  min-height: 450px;

  overflow: hidden;

  background: #242424;
}


.news-image img {

  display: block;

  width: 100%;

  height: 100%;

  object-fit: cover;

  object-position: center;

  transition: transform 0.35s ease;
}


.news-image:hover img {

  transform: scale(1.03);
}


.news-number {

  position: absolute;

  top: 25px;

  left: 28px;

  z-index: 3;

  color: rgba(247,244,237,0.85);

  font-size: 0.75rem;

  font-weight: 800;

  letter-spacing: 2px;

  text-shadow:
    0 1px 4px rgba(0,0,0,0.4);
}


/* ==================================================
   CONTENIDO DE LA NOTICIA
================================================== */

.main-news-content {

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: flex-start;

  width: 100%;

  height: 450px;

  min-height: 0;

  box-sizing: border-box;

  padding: 30px 42px;

  overflow: hidden;
}


/* ==================================================
   META
================================================== */

.news-meta {

  display: flex;

  gap: 10px;

  flex-shrink: 0;

  color: var(--gold);

  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 1.5px;
}


/* ==================================================
   TÍTULO
================================================== */

.main-news-content h3 {

  margin: 16px 0 14px;

  color: var(--cream);

  font-size: 2.35rem;

  line-height: 1.05;

  letter-spacing: -1px;
}


/* ==================================================
   DESCRIPCIÓN
================================================== */

.main-news-content p {

  max-width: 470px;

  margin: 0;

  color: rgba(247,244,237,0.65);

  font-size: 0.85rem;

  line-height: 1.55;
}


/* ==================================================
   AUTOR
================================================== */

.author {

  margin-top: 14px;

  color: rgba(247,244,237,0.55);

  font-size: 0.7rem;

  line-height: 1.4;
}


.author strong {

  color: var(--gold);

  font-weight: 800;
}


/* ==================================================
   BOTÓN
================================================== */

.read-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  flex-shrink: 0;

  width: fit-content;

  margin-top: 18px;

  padding: 9px 16px;

  border: 1px solid var(--gold);

  border-radius: 30px;

  color: var(--cream);

  text-decoration: none;

  font-size: 0.6rem;

  font-weight: 800;

  letter-spacing: 1.5px;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}


.read-button span {

  margin-left: 8px;

  color: var(--gold);

  font-size: 0.9rem;
}


.read-button:hover {

  background: var(--gold);

  color: var(--black);

  transform: translateY(-2px);
}


.read-button:hover span {

  color: var(--black);
}


/* ==================================================
   CATEGORÍAS
================================================== */

.news-categories {

  padding: 110px 20px;

  background: var(--white);
}


.section-heading {

  margin-bottom: 50px;
}


.section-heading h2 {

  margin: 0;

  font-size: clamp(2.6rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.section-heading h2 span {

  color: var(--terracotta);
}


.categories-grid {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 15px;
}


.category-card {

  position: relative;

  min-height: 290px;

  padding: 30px;

  overflow: hidden;

  border: 1px solid rgba(27,27,27,0.07);

  border-radius: 15px;

  background: var(--cream);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.category-card:hover {

  transform: translateY(-5px);

  border-color: rgba(200,162,74,0.5);

  box-shadow:
    0 15px 30px rgba(27,27,27,0.08);
}


.category-card.dark {

  background: var(--black);

  color: var(--cream);
}


.category-number {

  position: absolute;

  top: 20px;

  right: 22px;

  color: rgba(27,27,27,0.25);

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.dark .category-number {

  color: rgba(247,244,237,0.25);
}


.category-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 48px;

  height: 48px;

  margin-bottom: 28px;

  border: 1px solid rgba(200,162,74,0.45);

  border-radius: 50%;

  color: var(--gold);

  font-size: 0.9rem;

  font-weight: 800;
}


.category-card h3 {

  margin: 0 0 12px;

  font-size: 1.45rem;
}


.category-card p {

  margin: 0;

  color: #777;

  font-size: 0.9rem;

  line-height: 1.7;
}


.category-card.dark p {

  color: rgba(247,244,237,0.65);
}


/* ==================================================
   EDITORIAL
================================================== */

.editorial {

  padding: 120px 20px;

  background: var(--terracotta);

  color: white;

  text-align: center;
}


.editorial-content {

  max-width: 850px;

  margin: 0 auto;
}


.editorial-content > span {

  color: #F2D58B;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.editorial h2 {

  margin: 20px 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1.05;

  letter-spacing: -2px;
}


.editorial h2 strong {

  display: block;

  color: #F2D58B;
}


.editorial p {

  margin: 0;

  color: rgba(255,255,255,0.8);

  font-size: 1.05rem;

  line-height: 1.7;
}


/* ==================================================
   PRÓXIMAMENTE
================================================== */

.coming-section {

  padding: 90px 20px;

  background: var(--cream);
}


.coming-box {

  display: grid;

  grid-template-columns: 65px 1fr;

  gap: 30px;

  padding: 45px;

  background: white;

  border-left: 4px solid var(--gold);

  border-radius: 15px;

  box-shadow:
    0 10px 30px rgba(27,27,27,0.05);
}


.coming-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 55px;

  height: 55px;

  border-radius: 50%;

  background: rgba(200,162,74,0.12);

  color: var(--terracotta);

  font-size: 1.5rem;

  font-weight: 800;
}


.coming-box span {

  color: var(--terracotta);

  font-size: 0.68rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.coming-box h2 {

  margin: 12px 0;

  font-size: clamp(1.8rem, 4vw, 2.7rem);

  line-height: 1.1;
}


.coming-box p {

  max-width: 700px;

  margin: 0;

  color: var(--gray);

  line-height: 1.75;
}


/* ==================================================
   CIERRE
================================================== */

.actualidad-ending {

  padding: 110px 20px;

  background: var(--black);

  color: var(--cream);

  text-align: center;
}


.actualidad-ending span {

  color: var(--gold);

  font-size: 0.8rem;

  font-weight: 800;

  letter-spacing: 5px;
}


.actualidad-ending h2 {

  max-width: 800px;

  margin: 25px auto;

  font-size: clamp(2.2rem, 5vw, 3.8rem);

  line-height: 1.1;

  letter-spacing: -1px;
}


.actualidad-ending h2 strong {

  display: block;

  color: var(--gold);
}


.actualidad-ending p {

  margin: 0;

  color: rgba(247,244,237,0.45);

  font-size: 0.68rem;

  letter-spacing: 3px;
}


/* ==================================================
   TABLET
================================================== */

@media (max-width: 800px) {

  .actualidad-hero {

    min-height: 420px;
  }


  .section-top {

    display: block;
  }


  .section-top > p {

    margin-top: 20px;
  }


  .main-news {

    grid-template-columns: 1fr;

    height: auto;

    min-height: 0;

    max-height: none;
  }


  .news-image {

    height: 300px;

    min-height: 300px;
  }


  .main-news-content {

    height: auto;

    min-height: 400px;

    padding: 35px 28px;

    overflow: visible;
  }


  .categories-grid {

    grid-template-columns: repeat(2, 1fr);
  }

}


/* ==================================================
   CELULAR
================================================== */

@media (max-width: 550px) {

  .actualidad-hero .container {

    padding: 60px 0;
  }


  .actualidad-hero h1 {

    font-size: 3.4rem;

    letter-spacing: -2px;
  }


  .featured-news,
  .news-categories,
  .coming-section {

    padding: 80px 20px;
  }


  .categories-grid {

    grid-template-columns: 1fr;
  }


  .category-card {

    min-height: auto;

    padding: 28px;
  }


  .editorial {

    padding: 90px 20px;
  }


  .coming-box {

    grid-template-columns: 1fr;

    padding: 30px;
  }


  .actualidad-ending {

    padding: 90px 20px;
  }


  .main-news-content h3 {

    font-size: 2rem;
  }

}

</style>