---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase
  title="Actualidad Afro"
  description="Noticias, historias, voces y acontecimientos de las comunidades afrodescendientes en Bogotá."
>

  <main class="actualidad">

    <!-- ==========================================
         HERO
    =========================================== -->

    <section class="actualidad-hero">

      <div class="container">

        <span class="section-label">
          ACTUALIDAD AFRO
        </span>

        <h1>
          Lo que pasa
          <span>en nuestro territorio.</span>
        </h1>

        <p>
          Noticias, historias, voces y acontecimientos de interés
          para las comunidades afrodescendientes en Bogotá.
        </p>

      </div>

    </section>


    <!-- ==========================================
         NOTICIA DESTACADA
    =========================================== -->

    <section class="featured-news">

      <div class="container">

        <div class="section-top">

          <div>

            <span class="small-label">
              DESTACADA
            </span>

            <h2>
              Historias que
              <span>merecen ser contadas.</span>
            </h2>

          </div>

          <p>
            Un espacio para conocer las experiencias, iniciativas
            y acontecimientos que hacen parte de nuestros territorios.
          </p>

        </div>


        <article class="main-news">

          <a
            href="/actualidad/articulo-terremoto"
            class="news-image"
            aria-label="Leer artículo sobre el terremoto del 10 de agosto"
          >

            <img
              src="/images/imagen3.jpeg"
              alt="Daños ocasionados por el terremoto en el Pacífico colombiano"
            />

            <span class="news-number">
              01
            </span>

          </a>


          <div class="main-news-content">

            <div class="news-meta">

              <span>
                OPINIÓN / ANÁLISIS
              </span>

              <span>
                •
              </span>

              <span>
                ASHÉ
              </span>

            </div>


            <h3>
              El terremoto del 10 de agosto:
              la urgencia de mirar hacia el
              Pacífico tras el sismo
            </h3>


            <p>
              El impacto del terremoto de magnitud 7.4 dejó en
              evidencia el racismo estructural, la brecha en la
              infraestructura y la fuerza de la solidaridad
              comunitaria en el Chocó y Buenaventura.
            </p>


            <span class="author">
              Por:
              <strong>Maleja Banguera</strong>
            </span>


            <a
              href="/actualidad/articulo-terremoto"
              class="read-button"
            >
              LEER ARTÍCULO
              <span>→</span>
            </a>

          </div>

        </article>

      </div>

    </section>


    <!-- ==========================================
         CATEGORÍAS
    =========================================== -->

    <section class="news-categories">

      <div class="container">

        <div class="section-heading">

          <span class="section-label">
            EXPLORA
          </span>

          <h2>
            Nuestra
            <span>actualidad.</span>
          </h2>

        </div>


        <div class="categories-grid">

          <article class="category-card">

            <span class="category-number">
              01
            </span>

            <div class="category-icon">
              N
            </div>

            <h3>
              Noticias
            </h3>

            <p>
              Información sobre acontecimientos, iniciativas y
              hechos de interés para nuestras comunidades.
            </p>

          </article>


          <article class="category-card dark">

            <span class="category-number">
              02
            </span>

            <div class="category-icon">
              E
            </div>

            <h3>
              Entrevistas
            </h3>

            <p>
              Conversaciones con líderes, artistas, jóvenes,
              gestores y personas que aportan al territorio.
            </p>

          </article>


          <article class="category-card">

            <span class="category-number">
              03
            </span>

            <div class="category-icon">
              C
            </div>

            <h3>
              Crónicas
            </h3>

            <p>
              Historias narradas desde las experiencias y
              realidades de nuestras comunidades.
            </p>

          </article>


          <article class="category-card">

            <span class="category-number">
              04
            </span>

            <div class="category-icon">
              T
            </div>

            <h3>
              Territorio
            </h3>

            <p>
              Procesos comunitarios, participación y acontecimientos
              que transforman nuestros territorios.
            </p>

          </article>


          <article class="category-card dark">

            <span class="category-number">
              05
            </span>

            <div class="category-icon">
              J
            </div>

            <h3>
              Juventudes
            </h3>

            <p>
              Voces, iniciativas y experiencias de jóvenes
              afrodescendientes.
            </p>

          </article>


          <article class="category-card">

            <span class="category-number">
              06
            </span>

            <div class="category-icon">
              C
            </div>

            <h3>
              Cultura
            </h3>

            <p>
              Arte, música, danza, gastronomía y otras expresiones
              de nuestra identidad cultural.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- ==========================================
         EDITORIAL
    =========================================== -->

    <section class="editorial">

      <div class="container editorial-content">

        <span>
          DESDE EL TERRITORIO
        </span>

        <h2>
          No solo contamos
          <strong>lo que sucede.</strong>
        </h2>

        <p>
          Escuchamos, acompañamos y damos espacio a las voces
          que construyen comunidad.
        </p>

      </div>

    </section>


    <!-- ==========================================
         PRÓXIMAMENTE
    =========================================== -->

    <section class="coming-section">

      <div class="container coming-box">

        <div class="coming-icon">
          +
        </div>

        <div>

          <span>
            PRÓXIMAMENTE
          </span>

          <h2>
            Nuevas historias,
            nuevas voces.
          </h2>

          <p>
            ASHÉ está preparando nuevos contenidos periodísticos
            y comunitarios. Muy pronto podrás encontrar aquí
            nuestras primeras publicaciones.
          </p>

        </div>

      </div>

    </section>


    <!-- ==========================================
         CIERRE
    =========================================== -->

    <section class="actualidad-ending">

      <div class="container">

        <span>
          ASHÉ
        </span>

        <h2>
          La actualidad también
          <strong>construye memoria.</strong>
        </h2>

        <p>
          Información · Comunidad · Cultura · Territorio
        </p>

      </div>

    </section>

  </main>

</LayoutBase>


<style>

/* ==================================================
   VARIABLES
================================================== */

.actualidad {

  --black: #1B1B1B;
  --gold: #C8A24A;
  --terracotta: #A8572B;
  --cream: #F7F4ED;
  --white: #FFFFFF;
  --gray: #666666;

  background: var(--cream);

  color: var(--black);
}


/* ==================================================
   CONTENEDOR
================================================== */

.container {

  width: min(1000px, calc(100% - 40px));

  margin: 0 auto;
}


/* ==================================================
   HERO
================================================== */

.actualidad-hero {

  min-height: 420px;

  display: flex;

  align-items: center;

  position: relative;

  overflow: hidden;

  background: var(--black);

  color: var(--cream);
}


.actualidad-hero::before {

  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  right: -230px;
  top: -230px;

  border:
    1px solid
    rgba(200,162,74,0.18);

  border-radius: 50%;

  box-shadow:
    0 0 0 70px
    rgba(200,162,74,0.025),

    0 0 0 140px
    rgba(200,162,74,0.015);
}


.actualidad-hero::after {

  content: "";

  position: absolute;

  width: 230px;
  height: 230px;

  left: -120px;
  bottom: -120px;

  border:
    1px solid
    rgba(168,87,43,0.3);

  border-radius: 50%;
}


.actualidad-hero .container {

  position: relative;

  z-index: 2;

  padding: 60px 0;
}


.section-label {

  display: block;

  margin-bottom: 12px;

  color: var(--gold);

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 2.3px;
}


.actualidad-hero h1 {

  max-width: 760px;

  margin: 0;

  font-size: clamp(
    3.2rem,
    7vw,
    5.8rem
  );

  line-height: 0.92;

  letter-spacing: -3px;
}


.actualidad-hero h1 span {

  display: block;

  color: var(--gold);
}


.actualidad-hero p {

  max-width: 590px;

  margin: 24px 0 0;

  color:
    rgba(
      247,
      244,
      237,
      0.7
    );

  font-size: 0.92rem;

  line-height: 1.6;
}


/* ==================================================
   NOTICIA DESTACADA
================================================== */

.featured-news {

  padding: 65px 20px;

  background: var(--cream);
}


.section-top {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 35px;

  margin-bottom: 35px;
}


.small-label {

  display: block;

  margin-bottom: 10px;

  color: var(--terracotta);

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 2.3px;
}


.section-top h2 {

  margin: 0;

  font-size: clamp(
    2.1rem,
    4vw,
    3.3rem
  );

  line-height: 1;

  letter-spacing: -1.5px;
}


.section-top h2 span {

  display: block;

  color: var(--terracotta);
}


.section-top > p {

  max-width: 370px;

  margin: 0;

  color: var(--gray);

  font-size: 0.84rem;

  line-height: 1.6;
}


/* ==================================================
   TARJETA PRINCIPAL
================================================== */

.main-news {

  display: grid;

  grid-template-columns: 1fr 1fr;

  width: 100%;

  height: 450px;

  min-height: 450px;

  max-height: 450px;

  overflow: hidden;

  border-radius: 18px;

  background: var(--black);

  box-shadow:
    0 18px 38px
    rgba(27,27,27,0.1);
}


.news-image {

  position: relative;

  display: block;

  width: 100%;

  height: 450px;

  overflow: hidden;

  background: #242424;
}


.news-image img {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center;

  transition:
    transform 0.35s ease;
}


.news-image:hover img {

  transform: scale(1.03);
}


.news-number {

  position: absolute;

  top: 22px;
  left: 24px;

  z-index: 3;

  color:
    rgba(
      247,
      244,
      237,
      0.85
    );

  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 1.7px;
}


/* ==================================================
   CONTENIDO NOTICIA
================================================== */

.main-news-content {

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: flex-start;

  box-sizing: border-box;

  width: 100%;

  height: 450px;

  padding: 28px 35px;

  overflow: hidden;
}


.news-meta {

  display: flex;

  gap: 8px;

  color: var(--gold);

  font-size: 0.57rem;

  font-weight: 800;

  letter-spacing: 1.2px;
}


.main-news-content h3 {

  margin: 13px 0 12px;

  color: var(--cream);

  font-size: 1.9rem;

  line-height: 1.06;

  letter-spacing: -0.7px;
}


.main-news-content p {

  max-width: 450px;

  margin: 0;

  color:
    rgba(
      247,
      244,
      237,
      0.65
    );

  font-size: 0.78rem;

  line-height: 1.5;
}


.author {

  margin-top: 12px;

  color:
    rgba(
      247,
      244,
      237,
      0.5
    );

  font-size: 0.65rem;
}


.author strong {

  color: var(--gold);

  font-weight: 800;
}


.read-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  margin-top: 15px;

  padding: 8px 14px;

  border:
    1px solid
    var(--gold);

  border-radius: 25px;

  color: var(--cream);

  text-decoration: none;

  font-size: 0.55rem;

  font-weight: 800;

  letter-spacing: 1.2px;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}


.read-button span {

  margin-left: 7px;

  color: var(--gold);

  font-size: 0.85rem;
}


.read-button:hover {

  background: var(--gold);

  color: var(--black);

  transform: translateY(-2px);
}


.read-button:hover span {

  color: var(--black);
}


/* ==================================================
   CATEGORÍAS
================================================== */

.news-categories {

  padding: 65px 20px;

  background: var(--white);
}


.section-heading {

  margin-bottom: 35px;
}


.section-heading h2 {

  margin: 0;

  font-size: clamp(
    2.1rem,
    4vw,
    3.3rem
  );

  line-height: 1;

  letter-spacing: -1.5px;
}


.section-heading h2 span {

  color: var(--terracotta);
}


.categories-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 12px;
}


.category-card {

  position: relative;

  min-height: 270px;

  padding: 25px;

  overflow: hidden;

  border:
    1px solid
    rgba(27,27,27,0.07);

  border-radius: 14px;

  background: var(--cream);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.category-card:hover {

  transform: translateY(-4px);

  border-color:
    rgba(200,162,74,0.5);

  box-shadow:
    0 15px 30px
    rgba(27,27,27,0.08);
}


.category-card.dark {

  background: var(--black);

  color: var(--cream);
}


.category-number {

  position: absolute;

  top: 18px;
  right: 20px;

  color:
    rgba(27,27,27,0.25);

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 1.5px;
}


.dark .category-number {

  color:
    rgba(
      247,
      244,
      237,
      0.25
    );
}


.category-icon {

  display: flex;

  align-items: center;
  justify-content: center;

  width: 42px;
  height: 42px;

  margin-bottom: 20px;

  border:
    1px solid
    rgba(200,162,74,0.45);

  border-radius: 50%;

  color: var(--gold);

  font-size: 0.85rem;

  font-weight: 800;
}


.category-card h3 {

  margin: 0 0 10px;

  font-size: 1.2rem;
}


.category-card p {

  margin: 0;

  color: #777;

  font-size: 0.79rem;

  line-height: 1.55;
}


.category-card.dark p {

  color:
    rgba(
      247,
      244,
      237,
      0.65
    );
}


/* ==================================================
   EDITORIAL
================================================== */

.editorial {

  padding: 80px 20px;

  background: var(--terracotta);

  color: white;

  text-align: center;
}


.editorial-content {

  max-width: 760px;

  margin: 0 auto;
}


.editorial-content > span {

  color: #F2D58B;

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 2.3px;
}


.editorial h2 {

  margin: 16px 0;

  font-size: clamp(
    2.1rem,
    4vw,
    3.2rem
  );

  line-height: 1.05;

  letter-spacing: -1.5px;
}


.editorial h2 strong {

  display: block;

  color: #F2D58B;
}


.editorial p {

  margin: 0;

  color:
    rgba(
      255,
      255,
      255,
      0.8
    );

  font-size: 0.86rem;

  line-height: 1.6;
}


/* ==================================================
   PRÓXIMAMENTE
================================================== */

.coming-section {

  padding: 65px 20px;

  background: var(--cream);
}


.coming-box {

  display: grid;

  grid-template-columns: 55px 1fr;

  gap: 22px;

  padding: 32px;

  background: white;

  border-left:
    3px solid
    var(--gold);

  border-radius: 14px;

  box-shadow:
    0 8px 25px
    rgba(27,27,27,0.05);
}


.coming-icon {

  display: flex;

  align-items: center;
  justify-content: center;

  width: 45px;
  height: 45px;

  border-radius: 50%;

  background:
    rgba(200,162,74,0.12);

  color: var(--terracotta);

  font-size: 1.2rem;

  font-weight: 800;
}


.coming-box span {

  color: var(--terracotta);

  font-size: 0.58rem;

  font-weight: 800;

  letter-spacing: 1.7px;
}


.coming-box h2 {

  margin: 9px 0;

  font-size: clamp(
    1.6rem,
    3vw,
    2.3rem
  );

  line-height: 1.1;
}


.coming-box p {

  max-width: 650px;

  margin: 0;

  color: var(--gray);

  font-size: 0.82rem;

  line-height: 1.6;
}


/* ==================================================
   CIERRE
================================================== */

.actualidad-ending {

  padding: 80px 20px;

  background: var(--black);

  color: var(--cream);

  text-align: center;
}


.actualidad-ending span {

  color: var(--gold);

  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 4px;
}


.actualidad-ending h2 {

  max-width: 750px;

  margin: 20px auto;

  font-size: clamp(
    2rem,
    4vw,
    3rem
  );

  line-height: 1.1;

  letter-spacing: -0.8px;
}


.actualidad-ending h2 strong {

  display: block;

  color: var(--gold);
}


.actualidad-ending p {

  margin: 0;

  color:
    rgba(
      247,
      244,
      237,
      0.45
    );

  font-size: 0.56rem;

  letter-spacing: 2.3px;
}


/* ==================================================
   TABLET
================================================== */

@media (max-width: 800px) {

  .actualidad-hero {

    min-height: 400px;
  }


  .section-top {

    display: block;
  }


  .section-top > p {

    margin-top: 16px;
  }


  .main-news {

    grid-template-columns: 1fr;

    height: auto;

    min-height: 0;

    max-height: none;
  }


  .news-image {

    height: 300px;

    min-height: 300px;
  }


  .main-news-content {

    height: auto;

    min-height: 350px;

    padding: 30px 25px;

    overflow: visible;
  }


  .categories-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

}


/* ==================================================
   CELULAR
================================================== */

@media (max-width: 550px) {

  .container {

    width:
      calc(
        100% - 32px
      );
  }


  .actualidad-hero {

    min-height: 390px;
  }


  .actualidad-hero .container {

    padding: 50px 0;
  }


  .actualidad-hero h1 {

    font-size: clamp(
      3rem,
      15vw,
      4.5rem
    );

    letter-spacing: -2px;
  }


  .actualidad-hero p {

    margin-top: 20px;

    font-size: 0.82rem;
  }


  .featured-news,
  .news-categories,
  .coming-section {

    padding: 55px 16px;
  }


  .section-top h2,
  .section-heading h2 {

    font-size: 2.1rem;
  }


  .main-news-content {

    padding: 28px 22px;
  }


  .main-news-content h3 {

    font-size: 1.65rem;
  }


  .main-news-content p {

    font-size: 0.76rem;
  }


  .categories-grid {

    grid-template-columns: 1fr;
  }


  .category-card {

    min-height: 250px;

    padding: 24px;
  }


  .editorial {

    padding: 65px 16px;
  }


  .editorial h2 {

    font-size: 2rem;
  }


  .coming-box {

    grid-template-columns: 1fr;

    padding: 28px;
  }


  .actualidad-ending {

    padding: 65px 16px;
  }


  .actualidad-ending h2 {

    font-size: 1.9rem;
  }

}

</style>