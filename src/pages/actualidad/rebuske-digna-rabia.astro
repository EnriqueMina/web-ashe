  @media (max-width: 800px) { .article-hero { min-height: 480px; padding: 65px 20px 70px; } .article-content { padding-top: 65px; } }
  @media (max-width: 600px) {
    .container { width: min(100%, calc(100% - 40px)); }
    .article-hero { min-height: auto; padding: 60px 20px 65px; }
    .back-top { margin-bottom: 24px; }
    .section-label { margin-bottom: 15px; font-size: .64rem; letter-spacing: 2.5px; }
    .article-hero h1 { font-size: clamp(2.2rem, 10vw, 3rem); line-height: 1.02; letter-spacing: -1.5px; }
    .lead { margin-top: 25px; font-size: 1rem; line-height: 1.7; }
    .article-meta { margin-top: 25px; font-size: .64rem; }
    .article-content { padding: 55px 20px 80px; }
    .article-text { max-width: 100%; }
    .article-text p { margin-bottom: 25px; font-size: 1rem; line-height: 1.8; }
    .article-text .intro { margin-bottom: 38px; font-size: 1.08rem; line-height: 1.7; }
    .section-title { margin: 55px 0 22px; font-size: 2rem; letter-spacing: -.8px; }
    .highlight { margin: 35px 0; padding: 24px 22px; }
    .article-image { margin: 28px auto 34px; }
    .article-image img { max-height: 520px; }
