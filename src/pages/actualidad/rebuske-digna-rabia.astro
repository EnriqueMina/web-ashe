  .article-hero h1 { max-width: 850px; margin: 0; color: #F7F4ED; font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.04; letter-spacing: -2px; font-weight: 700; }
  .lead { max-width: 680px; margin: 30px 0 0; color: rgba(247,244,237,.76); font-size: 1rem; line-height: 1.75; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; color: #C8A24A; font-size: .68rem; font-weight: 800; letter-spacing: 2px; }
  .article-meta span { color: #C8A24A; }
  .article-content { padding: 75px 20px 100px; background: #F7F4ED; color: #1B1B1B; }
  .article-text { max-width: 680px; margin: 0 auto; }
  .article-text p { margin: 0 0 28px; color: #383838; font-size: 1rem; line-height: 1.8; text-align: justify; text-justify: inter-word; }
  .article-text .intro { margin-bottom: 38px; color: #1B1B1B; font-size: 1.12rem; font-weight: 500; line-height: 1.75; }
  .section-title { margin: 65px 0 25px; color: #1B1B1B; font-size: 2.2rem; line-height: 1.1; letter-spacing: -1px; }
