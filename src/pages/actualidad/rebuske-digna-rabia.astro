  .article-hero { min-height: 510px; display: flex; align-items: center; padding: 75px 20px 80px; background: #1B1B1B; color: #F7F4ED; }
  .back-top { display: inline-block; margin-bottom: 28px; color: #F7F4ED; text-decoration: none; font-size: .72rem; font-weight: 800; letter-spacing: 1px; }
  .back-top:hover { color: #C8A24A; }
