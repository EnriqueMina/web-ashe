---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Oportunidades">

  <!-- ==========================================
       HERO
  =========================================== -->

  <section class="oportunidades-hero">

    <div class="hero-circle"></div>

    <div class="container">

      <span class="section-label">
        INFORMACIÓN PARA LA COMUNIDAD
      </span>

      <h1>
        Oportunidades
        <span>para crecer.</span>
      </h1>

      <p>
        Un espacio para encontrar convocatorias, formación,
        empleo y oportunidades que puedan aportar al desarrollo
        personal, académico y comunitario.
      </p>

    </div>

  </section>


  <!-- ==========================================
       INTRODUCCIÓN
  =========================================== -->

  <section class="oportunidades-intro">

    <div class="container intro-grid">

      <div>

        <span class="small-label">
          ENCUENTRA NUEVAS POSIBILIDADES
        </span>

        <h2>
          Información que
          <span>abre caminos.</span>
        </h2>

      </div>

      <div class="intro-text">

        <p>
          Las oportunidades de formación, empleo, educación y
          participación pueden convertirse en herramientas para
          fortalecer nuestros proyectos de vida y nuestras comunidades.
        </p>

        <p>
          En ASHÉ queremos reunir y compartir información útil
          para que más personas puedan conocer diferentes opciones
          y acceder a nuevas posibilidades.
        </p>

      </div>

    </div>

  </section>


  <!-- ==========================================
       CATEGORÍAS
  =========================================== -->

  <section class="categorias">

    <div class="container">

      <div class="section-header">

        <div>

          <span class="section-label">
            EXPLORA
          </span>

          <h2>
            Encuentra tu
            <span>oportunidad.</span>
          </h2>

        </div>

        <p>
          Consulta las diferentes categorías de información
          que iremos compartiendo desde ASHÉ.
        </p>

      </div>


      <div class="opportunities-grid">

        <article class="opportunity-card featured">

          <div class="card-number">
            01
          </div>

          <div class="opportunity-icon">
            ✦
          </div>

          <span class="card-category">
            EDUCACIÓN
          </span>

          <h3>
            Becas
          </h3>

          <p>
            Información sobre oportunidades de apoyo educativo,
            convocatorias académicas y alternativas para continuar
            procesos de formación.
          </p>

        </article>


        <article class="opportunity-card">

          <div class="card-number">
            02
          </div>

          <div class="opportunity-icon">
            +
          </div>

          <span class="card-category">
            TRABAJO
          </span>

          <h3>
            Empleo
          </h3>

          <p>
            Vacantes, iniciativas y oportunidades laborales que
            puedan ser de interés para nuestra comunidad.
          </p>

        </article>


        <article class="opportunity-card">

          <div class="card-number">
            03
          </div>

          <div class="opportunity-icon">
            ◇
          </div>

          <span class="card-category">
            APRENDIZAJE
          </span>

          <h3>
            Formación
          </h3>

          <p>
            Cursos, talleres, capacitaciones y espacios de aprendizaje
            para fortalecer conocimientos y habilidades.
          </p>

        </article>


        <article class="opportunity-card">

          <div class="card-number">
            04
          </div>

          <div class="opportunity-icon">
            ◉
          </div>

          <span class="card-category">
            PARTICIPACIÓN
          </span>

          <h3>
            Convocatorias
          </h3>

          <p>
            Invitaciones a proyectos, iniciativas y procesos
            comunitarios, culturales o educativos.
          </p>

        </article>


        <article class="opportunity-card featured">

          <div class="card-number">
            05
          </div>

          <div class="opportunity-icon">
            ◆
          </div>

          <span class="card-category">
            EMPRENDIMIENTO
          </span>

          <h3>
            Iniciativas
          </h3>

          <p>
            Espacios y oportunidades que puedan apoyar proyectos,
            emprendimientos e iniciativas de nuestra comunidad.
          </p>

        </article>


        <article class="opportunity-card">

          <div class="card-number">
            06
          </div>

          <div class="opportunity-icon">
            ∞
          </div>

          <span class="card-category">
            COMUNIDAD
          </span>

          <h3>
            Participación
          </h3>

          <p>
            Espacios para conocer iniciativas, actividades y procesos
            donde la comunidad pueda participar y aportar.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- ==========================================
       CONVOCATORIA DESTACADA
  =========================================== -->

  <section class="convocatoria-destacada">

    <div class="container">

      <div class="convocatoria-header">

        <div>

          <span class="section-label">
            04 · PARTICIPACIÓN
          </span>

          <h2>
            Convocatoria
            <span>destacada.</span>
          </h2>

        </div>

        <p>
          Un espacio de participación y construcción colectiva
          para las comunidades negras y afrocolombianas de Usme.
        </p>

      </div>


      <article class="convocatoria-card">

        <!-- LADO IZQUIERDO -->

        <div class="convocatoria-visual">

          <div class="visual-top">

            <span>
              ASHÉ
            </span>

            <span>
              CONVOCATORIA
            </span>

          </div>


          <div class="visual-center">

            <span class="visual-number">
              01
            </span>

            <h3>
              Mesa de Concertación
              <span>Diálogos Diferenciales Afro</span>
            </h3>

            <p>
              Usme · Participación comunitaria
            </p>

          </div>


          <div class="visual-bottom">

            <span>
              PARTICIPACIÓN
            </span>

            <span>
              2026
            </span>

          </div>

        </div>


        <!-- LADO DERECHO -->

        <div class="convocatoria-content">

          <div class="convocatoria-meta">

            <span>
              PARTICIPACIÓN
            </span>

            <span>
              •
            </span>

            <span>
              USME
            </span>

          </div>


          <h3>
            Mesa de Concertación para los
            Diálogos Diferenciales Afro en Usme
          </h3>


          <p>
            La Alcaldía Local de Usme convoca a la comunidad
            negra y afrocolombiana a participar en un espacio
            de diálogo y concertación en el marco de los
            Presupuestos Participativos.
          </p>


          <div class="datos-convocatoria">

            <div>

              <span>
                FECHA
              </span>

              <strong>
                16 SEP 2026
              </strong>

            </div>


            <div>

              <span>
                HORA
              </span>

              <strong>
                2:00 P. M.
              </strong>

            </div>


            <div>

              <span>
                LUGAR
              </span>

              <strong>
                ALCALDÍA LOCAL DE USME
              </strong>

            </div>

          </div>


          <div class="convocatoria-footer">

            <a
              href="/oportunidades/mesa-concertacion-afro-usme"
              class="convocatoria-button"
            >
              LEER CONVOCATORIA
              <span>→</span>
            </a>

            <span class="convocatoria-category">
              PRESUPUESTOS<br />
              PARTICIPATIVOS
            </span>

          </div>

        </div>

      </article>

    </div>

  </section>


  <!-- ==========================================
       MÁS OPORTUNIDADES
  =========================================== -->

  <section class="oportunidades-aviso">

    <div class="container aviso-box">

      <div class="aviso-icon">
        +
      </div>

      <div>

        <span>
          MÁS OPORTUNIDADES PRÓXIMAMENTE
        </span>

        <h2>
          Nuevas oportunidades
          para nuestra comunidad.
        </h2>

        <p>
          Estamos preparando nuevas convocatorias, becas, empleos,
          espacios de formación e iniciativas para compartir con
          nuestra comunidad.
        </p>

      </div>

    </div>

  </section>


  <!-- ==========================================
       FRASE
  =========================================== -->

  <section class="oportunidades-frase">

    <div class="container">

      <span>
        ASHÉ
      </span>

      <h2>
        Una oportunidad puede convertirse
        <strong>en un nuevo comienzo.</strong>
      </h2>

      <p>
        INFORMACIÓN · FORMACIÓN · PARTICIPACIÓN · COMUNIDAD
      </p>

    </div>

  </section>


  <!-- ==========================================
       CIERRE
  =========================================== -->

  <section class="oportunidades-cierre">

    <div class="container cierre-grid">

      <div>

        <span class="section-label">
          SEGUIMOS CRECIENDO
        </span>

        <h2>
          Conectar información
          <span>también es construir comunidad.</span>
        </h2>

      </div>

      <div>

        <p>
          ASHÉ busca convertirse en un punto de encuentro para
          conocer información, iniciativas y oportunidades que
          puedan aportar al fortalecimiento de nuestras comunidades.
        </p>

        <a
          href="/comunidad"
          class="button"
        >
          Conocer la comunidad
          <span>→</span>
        </a>

      </div>

    </div>

  </section>

</LayoutBase>


<style>

/* ==================================================
   GENERAL
================================================== */

.container {
  width: min(1000px, calc(100% - 40px));
  margin: 0 auto;
}


.section-label {
  display: block;
  margin-bottom: 18px;
  color: #C8A24A;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 3px;
}


/* ==================================================
   HERO
================================================== */

.oportunidades-hero {

  position: relative;

  min-height: 520px;

  display: flex;

  align-items: center;

  overflow: hidden;

  background: #1B1B1B;

  color: #F7F4ED;
}


.oportunidades-hero::before {

  content: "";

  position: absolute;

  width: 600px;
  height: 600px;

  right: -250px;
  top: -250px;

  border: 1px solid rgba(200,162,74,0.18);

  border-radius: 50%;

  box-shadow:
    0 0 0 80px rgba(200,162,74,0.025),
    0 0 0 160px rgba(200,162,74,0.015);
}


.hero-circle {

  position: absolute;

  width: 300px;
  height: 300px;

  left: -160px;
  bottom: -160px;

  border: 1px solid rgba(168,87,43,0.35);

  border-radius: 50%;
}


.oportunidades-hero .container {

  position: relative;

  z-index: 2;

  padding: 80px 0;
}


.oportunidades-hero h1 {

  max-width: 850px;

  margin: 0;

  font-size: clamp(3.5rem, 8vw, 6.5rem);

  line-height: 0.92;

  letter-spacing: -4px;
}


.oportunidades-hero h1 span {

  display: block;

  color: #C8A24A;
}


.oportunidades-hero p {

  max-width: 650px;

  margin: 35px 0 0;

  color: rgba(247,244,237,0.72);

  font-size: 1.08rem;

  line-height: 1.75;
}


/* ==================================================
   INTRO
================================================== */

.oportunidades-intro {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.intro-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}


.small-label {

  color: #A8572B;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.intro-grid h2 {

  margin: 18px 0 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.intro-grid h2 span {

  display: block;

  color: #A8572B;
}


.intro-text {

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


.intro-text p {

  margin: 0 0 20px;
}


/* ==================================================
   CATEGORÍAS
================================================== */

.categorias {

  padding: 110px 20px;

  background: #FFFFFF;

  color: #1B1B1B;
}


.section-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 50px;

  margin-bottom: 55px;
}


.section-header h2 {

  margin: 0;

  font-size: clamp(2.6rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.section-header h2 span {

  color: #A8572B;
}


.section-header > p {

  max-width: 400px;

  margin: 0;

  color: #777;

  line-height: 1.7;
}


.opportunities-grid {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 15px;
}


/* ==================================================
   TARJETAS
================================================== */

.opportunity-card {

  position: relative;

  min-height: 320px;

  padding: 32px;

  overflow: hidden;

  background: #F7F4ED;

  border: 1px solid rgba(27,27,27,0.07);

  border-radius: 16px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.opportunity-card:hover {

  transform: translateY(-5px);

  border-color: rgba(200,162,74,0.5);

  box-shadow:
    0 18px 35px rgba(27,27,27,0.08);
}


.opportunity-card.featured {

  background: #1B1B1B;

  color: #F7F4ED;
}


.card-number {

  position: absolute;

  top: 22px;

  right: 25px;

  color: rgba(27,27,27,0.25);

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.featured .card-number {

  color: rgba(247,244,237,0.25);
}


.opportunity-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 48px;

  height: 48px;

  margin-bottom: 22px;

  color: #C8A24A;

  border: 1px solid rgba(200,162,74,0.45);

  border-radius: 50%;

  font-size: 1.15rem;
}


.card-category {

  display: block;

  margin-bottom: 8px;

  color: #A8572B;

  font-size: 0.6rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.featured .card-category {

  color: #C8A24A;
}


.opportunity-card h3 {

  margin: 0 0 15px;

  font-size: 1.5rem;

  line-height: 1.1;
}


.opportunity-card p {

  margin: 0;

  color: #777;

  font-size: 0.9rem;

  line-height: 1.7;
}


.featured p {

  color: rgba(247,244,237,0.65);
}


/* ==================================================
   CONVOCATORIA
================================================== */

.convocatoria-destacada {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.convocatoria-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 50px;

  margin-bottom: 55px;
}


.convocatoria-header h2 {

  margin: 0;

  font-size: clamp(2.6rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.convocatoria-header h2 span {

  display: block;

  color: #A8572B;
}


.convocatoria-header > p {

  max-width: 400px;

  margin: 0;

  color: #777;

  line-height: 1.7;
}


/* ==================================================
   TARJETA
================================================== */

.convocatoria-card {

  display: grid;

  grid-template-columns: 1fr 1fr;

  width: 100%;

  height: 450px;

  min-height: 450px;

  max-height: 450px;

  overflow: hidden;

  background: #FFFFFF;

  border-radius: 18px;

  box-shadow:
    0 20px 45px rgba(27,27,27,0.12);
}


/* ==================================================
   LADO IZQUIERDO
================================================== */

.convocatoria-visual {

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  padding: 35px;

  overflow: hidden;

  background: #1B1B1B;

  color: #F7F4ED;
}


.visual-top,
.visual-bottom {

  display: flex;

  justify-content: space-between;

  gap: 20px;

  font-size: 0.68rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.visual-top span:last-child,
.visual-bottom span:first-child {

  color: #C8A24A;
}


.visual-center {

  max-width: 430px;
}


.visual-number {

  display: block;

  margin-bottom: 18px;

  color: #C8A24A;

  font-size: 0.85rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.visual-center h3 {

  margin: 0;

  font-size: clamp(2rem, 3.5vw, 2.7rem);

  line-height: 1.05;

  letter-spacing: -1px;
}


.visual-center h3 span {

  display: block;

  color: #C8A24A;
}


.visual-center p {

  margin: 18px 0 0;

  color: #D9D4C8;

  font-size: 0.88rem;

  letter-spacing: 1px;
}


/* ==================================================
   LADO DERECHO
================================================== */

.convocatoria-content {

  display: flex;

  flex-direction: column;

  justify-content: center;

  padding: 28px 40px;

  overflow: hidden;
}


.convocatoria-meta {

  display: flex;

  gap: 10px;

  margin-bottom: 12px;

  color: #A8572B;

  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.convocatoria-content h3 {

  margin: 0 0 14px;

  font-size: clamp(1.65rem, 2.5vw, 2.15rem);

  line-height: 1.06;

  letter-spacing: -1px;
}


.convocatoria-content > p {

  max-width: 500px;

  margin: 0;

  color: #555;

  font-size: 0.86rem;

  line-height: 1.5;
}


/* ==================================================
   DATOS
================================================== */

.datos-convocatoria {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 12px;

  margin-top: 20px;

  padding-top: 17px;

  border-top: 1px solid #E5E0D7;
}


.datos-convocatoria div {

  display: flex;

  flex-direction: column;

  gap: 4px;
}


.datos-convocatoria span {

  color: #A8572B;

  font-size: 0.57rem;

  font-weight: 800;

  letter-spacing: 1.5px;
}


.datos-convocatoria strong {

  color: #1B1B1B;

  font-size: 0.68rem;

  line-height: 1.25;
}


/* ==================================================
   BOTÓN
================================================== */

.convocatoria-footer {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  margin-top: 18px;
}


.convocatoria-button {

  display: inline-flex;

  align-items: center;

  gap: 12px;

  padding: 11px 17px;

  background: #A8572B;

  color: #FFFFFF;

  text-decoration: none;

  font-size: 0.64rem;

  font-weight: 800;

  letter-spacing: 1px;

  text-transform: uppercase;

  transition: 0.25s ease;
}


.convocatoria-button:hover {

  background: #1B1B1B;
}


.convocatoria-button span {

  font-size: 1rem;
}


.convocatoria-category {

  color: #888;

  font-size: 0.58rem;

  font-weight: 800;

  line-height: 1.4;

  letter-spacing: 1.5px;

  text-align: right;
}


/* ==================================================
   AVISO
================================================== */

.oportunidades-aviso {

  padding: 90px 20px;

  background: #F7F4ED;
}


.aviso-box {

  display: grid;

  grid-template-columns: 70px 1fr;

  gap: 30px;

  align-items: start;

  padding: 45px;

  background: #FFFFFF;

  border: 1px solid rgba(27,27,27,0.08);

  border-left: 4px solid #C8A24A;

  border-radius: 15px;
}


.aviso-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 55px;

  height: 55px;

  background: rgba(200,162,74,0.12);

  color: #A8572B;

  border-radius: 50%;

  font-size: 1.3rem;

  font-weight: 800;
}


.aviso-box span {

  color: #A8572B;

  font-size: 0.68rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.aviso-box h2 {

  max-width: 700px;

  margin: 12px 0;

  color: #1B1B1B;

  font-size: clamp(1.8rem, 4vw, 2.7rem);

  line-height: 1.1;
}


.aviso-box p {

  max-width: 700px;

  margin: 0;

  color: #666;

  line-height: 1.75;
}


/* ==================================================
   FRASE
================================================== */

.oportunidades-frase {

  padding: 120px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.oportunidades-frase span {

  display: block;

  margin-bottom: 25px;

  color: #C8A24A;

  font-size: 0.8rem;

  font-weight: 800;

  letter-spacing: 5px;
}


.oportunidades-frase h2 {

  max-width: 850px;

  margin: 0 auto;

  font-size: clamp(2rem, 4vw, 3.5rem);

  line-height: 1.15;

  letter-spacing: -1px;
}


.oportunidades-frase strong {

  display: block;

  color: #C8A24A;
}


.oportunidades-frase p {

  margin: 30px 0 0;

  color: rgba(247,244,237,0.45);

  font-size: 0.68rem;

  letter-spacing: 3px;
}


/* ==================================================
   CIERRE
================================================== */

.oportunidades-cierre {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.cierre-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}


.cierre-grid h2 {

  margin: 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.cierre-grid h2 span {

  display: block;

  color: #A8572B;
}


.cierre-grid p {

  margin: 0;

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


.button {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  margin-top: 25px;

  padding: 14px 22px;

  background: #C8A24A;

  color: #1B1B1B;

  border-radius: 25px;

  font-size: 0.82rem;

  font-weight: 800;

