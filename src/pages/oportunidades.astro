---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Oportunidades">

  <!-- ==========================================
       HERO
  =========================================== -->

  <section class="oportunidades-hero">

    <div class="hero-circle"></div>

    <div class="container">

      <span class="section-label">
        INFORMACIÓN PARA LA COMUNIDAD
      </span>

      <h1>
        Oportunidades
        <span>para crecer.</span>
      </h1>

      <p>
        Un espacio para encontrar convocatorias, formación,
        empleo y oportunidades que puedan aportar al desarrollo
        personal, académico y comunitario.
      </p>

    </div>

  </section>


  <!-- ==========================================
       INTRODUCCIÓN
  =========================================== -->

  <section class="oportunidades-intro">

    <div class="container intro-grid">

      <div>

        <span class="small-label">
          ENCUENTRA NUEVAS POSIBILIDADES
        </span>

        <h2>
          Información que
          <span>abre caminos.</span>
        </h2>

      </div>

      <div class="intro-text">

        <p>
          Las oportunidades de formación, empleo, educación y
          participación pueden convertirse en herramientas para
          fortalecer nuestros proyectos de vida y nuestras comunidades.
        </p>

        <p>
          En ASHÉ queremos reunir y compartir información útil
          para que más personas puedan conocer diferentes opciones
          y acceder a nuevas posibilidades.
        </p>

      </div>

    </div>

  </section>


  <!-- ==========================================
       CATEGORÍAS
  =========================================== -->

  <section class="categorias">

    <div class="container">

      <div class="section-header">

        <div>

          <span class="section-label">
            EXPLORA
          </span>

          <h2>
            Encuentra tu
            <span>oportunidad.</span>
          </h2>

        </div>

        <p>
          Consulta las diferentes categorías de información
          que iremos compartiendo desde ASHÉ.
        </p>

      </div>


      <div class="opportunities-grid">

        <article class="opportunity-card featured">

          <div class="card-number">
            01
          </div>

          <div class="opportunity-icon">
            ✦
          </div>

          <span class="card-category">
            EDUCACIÓN
          </span>

          <h3>
            Becas
          </h3>

          <p>
            Información sobre oportunidades de apoyo educativo,
            convocatorias académicas y alternativas para continuar
            procesos de formación.
          </p>

        </article>


        <article class="opportunity-card">

          <div class="card-number">
            02
          </div>

          <div class="opportunity-icon">
            +
          </div>

          <span class="card-category">
            TRABAJO
          </span>

          <h3>
            Empleo
          </h3>

          <p>
            Vacantes, iniciativas y oportunidades laborales que
            puedan ser de interés para nuestra comunidad.
          </p>

        </article>


        <article class="opportunity-card">

          <div class="card-number">
            03
          </div>

          <div class="opportunity-icon">
            ◇
          </div>

          <span class="card-category">
            APRENDIZAJE
          </span>

          <h3>
            Formación
          </h3>

          <p>
            Cursos, talleres, capacitaciones y espacios de aprendizaje
            para fortalecer conocimientos y habilidades.
          </p>

        </article>


        <article class="opportunity-card">

          <div class="card-number">
            04
          </div>

          <div class="opportunity-icon">
            ◉
          </div>

          <span class="card-category">
            PARTICIPACIÓN
          </span>

          <h3>
            Convocatorias
          </h3>

          <p>
            Invitaciones a proyectos, iniciativas y procesos
            comunitarios, culturales o educativos.
          </p>

        </article>


        <article class="opportunity-card featured">

          <div class="card-number">
            05
          </div>

          <div class="opportunity-icon">
            ◆
          </div>

          <span class="card-category">
            EMPRENDIMIENTO
          </span>

          <h3>
            Iniciativas
          </h3>

          <p>
            Espacios y oportunidades que puedan apoyar proyectos,
            emprendimientos e iniciativas de nuestra comunidad.
          </p>

        </article>


        <article class="opportunity-card">

          <div class="card-number">
            06
          </div>

          <div class="opportunity-icon">
            ∞
          </div>

          <span class="card-category">
            COMUNIDAD
          </span>

          <h3>
            Participación
          </h3>

          <p>
            Espacios para conocer iniciativas, actividades y procesos
            donde la comunidad pueda participar y aportar.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- ==========================================
       CONVOCATORIA DESTACADA
  =========================================== -->

  <section class="convocatoria-destacada">

    <div class="container">

      <div class="convocatoria-header">

        <div>

          <span class="section-label">
            04 · PARTICIPACIÓN
          </span>

          <h2>
            Convocatoria
            <span>destacada.</span>
          </h2>

        </div>

        <p>
          Un espacio de participación y construcción colectiva
          para las comunidades negras y afrocolombianas de Usme.
        </p>

      </div>


      <article class="convocatoria-card">

        <div class="convocatoria-visual">

          <div class="visual-top">

            <span>
              ASHÉ
            </span>

            <span>
              CONVOCATORIA
            </span>

          </div>


          <div class="visual-center">

            <span class="visual-number">
              01
            </span>

            <h3>
              Mesa de Concertación
              <span>Diálogos Diferenciales Afro</span>
            </h3>

            <p>
              Usme · Participación comunitaria
            </p>

          </div>


          <div class="visual-bottom">

            <span>
              PARTICIPACIÓN
            </span>

            <span>
              2026
            </span>

          </div>

        </div>


        <div class="convocatoria-content">

          <div class="convocatoria-meta">

            <span>
              PARTICIPACIÓN
            </span>

            <span>
              •
            </span>

            <span>
              USME
            </span>

          </div>


          <h3>
            Mesa de Concertación para los
            Diálogos Diferenciales Afro en Usme
          </h3>


          <p>
            La Alcaldía Local de Usme convoca a la comunidad
            negra y afrocolombiana a participar en un espacio
            de diálogo y concertación en el marco de los
            Presupuestos Participativos.
          </p>


          <div class="datos-convocatoria">

            <div>

              <span>
                FECHA
              </span>

              <strong>
                16 SEP 2026
              </strong>

            </div>


            <div>

              <span>
                HORA
              </span>

              <strong>
                2:00 P. M.
              </strong>

            </div>


            <div>

              <span>
                LUGAR
              </span>

              <strong>
                ALCALDÍA LOCAL DE USME
              </strong>

            </div>

          </div>


          <div class="convocatoria-footer">

            <a
              href="/oportunidades/mesa-concertacion-afro-usme"
              class="convocatoria-button"
            >
              LEER CONVOCATORIA
              <span>→</span>
            </a>

            <span class="convocatoria-category">
              PRESUPUESTOS<br />
              PARTICIPATIVOS
            </span>

          </div>

        </div>

      </article>

    </div>

  </section>


  <!-- ==========================================
       MÁS OPORTUNIDADES
  =========================================== -->

  <section class="oportunidades-aviso">

    <div class="container aviso-box">

      <div class="aviso-icon">
        +
      </div>

      <div>

        <span>
          MÁS OPORTUNIDADES PRÓXIMAMENTE
        </span>

        <h2>
          Nuevas oportunidades
          para nuestra comunidad.
        </h2>

        <p>
          Estamos preparando nuevas convocatorias, becas, empleos,
          espacios de formación e iniciativas para compartir con
          nuestra comunidad.
        </p>

      </div>

    </div>

  </section>


  <!-- ==========================================
       FRASE
  =========================================== -->

  <section class="oportunidades-frase">

    <div class="container">

      <span>
        ASHÉ
      </span>

      <h2>
        Una oportunidad puede convertirse
        <strong>en un nuevo comienzo.</strong>
      </h2>

      <p>
        INFORMACIÓN · FORMACIÓN · PARTICIPACIÓN · COMUNIDAD
      </p>

    </div>

  </section>


  <!-- ==========================================
       CIERRE
  =========================================== -->

  <section class="oportunidades-cierre">

    <div class="container cierre-grid">

      <div>

        <span class="section-label">
          SEGUIMOS CRECIENDO
        </span>

        <h2>
          Conectar información
          <span>también es construir comunidad.</span>
        </h2>

      </div>

      <div>

        <p>
          ASHÉ busca convertirse en un punto de encuentro para
          conocer información, iniciativas y oportunidades que
          puedan aportar al fortalecimiento de nuestras comunidades.
        </p>

        <a
          href="/comunidad"
          class="button"
        >
          Conocer la comunidad
          <span>→</span>
        </a>

      </div>

    </div>

  </section>

</LayoutBase>


<style>

/* ==================================================
   GENERAL
================================================== */

.container {
  width: min(1000px, calc(100% - 40px));
  margin: 0 auto;
}


/* ==================================================
   ETIQUETAS
================================================== */

.section-label {
  display: block;
  margin-bottom: 12px;
  color: #C8A24A;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 2.3px;
}


.small-label {
  color: #A8572B;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 2.3px;
}


/* ==================================================
   HERO
================================================== */

.oportunidades-hero {

  position: relative;

  min-height: 450px;

  display: flex;

  align-items: center;

  overflow: hidden;

  background: #1B1B1B;

  color: #F7F4ED;
}


.oportunidades-hero::before {

  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  right: -230px;
  top: -230px;

  border:
    1px solid
    rgba(200,162,74,0.18);

  border-radius: 50%;

  box-shadow:
    0 0 0 70px
    rgba(200,162,74,0.025),

    0 0 0 140px
    rgba(200,162,74,0.015);
}


.hero-circle {

  position: absolute;

  width: 260px;
  height: 260px;

  left: -140px;
  bottom: -140px;

  border:
    1px solid
    rgba(168,87,43,0.3);

  border-radius: 50%;
}


.oportunidades-hero .container {

  position: relative;

  z-index: 2;

  padding: 60px 0;
}


.oportunidades-hero h1 {

  max-width: 760px;

  margin: 0;

  font-size:
    clamp(3.2rem, 7vw, 5.8rem);

  line-height: 0.92;

  letter-spacing: -3px;
}


.oportunidades-hero h1 span {

  display: block;

  color: #C8A24A;
}


.oportunidades-hero p {

  max-width: 590px;

  margin: 24px 0 0;

  color:
    rgba(247,244,237,0.72);

  font-size: 0.92rem;

  line-height: 1.6;
}


/* ==================================================
   INTRO
================================================== */

.oportunidades-intro {

  padding: 65px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.intro-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 55px;

  align-items: center;
}


.intro-grid h2 {

  margin: 12px 0 0;

  font-size:
    clamp(2.1rem, 4vw, 3.3rem);

  line-height: 1;

  letter-spacing: -1.5px;
}


.intro-grid h2 span {

  display: block;

  color: #A8572B;
}


.intro-text {

  color: #666;

  font-size: 0.86rem;

  line-height: 1.6;
}


.intro-text p {

  margin: 0 0 16px;
}


/* ==================================================
   CATEGORÍAS
================================================== */

.categorias {

  padding: 65px 20px;

  background: #FFFFFF;

  color: #1B1B1B;
}


.section-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 35px;

  margin-bottom: 35px;
}


.section-header h2 {

  margin: 0;

  font-size:
    clamp(2.1rem, 4vw, 3.3rem);

  line-height: 1;

  letter-spacing: -1.5px;
}


.section-header h2 span {

  color: #A8572B;
}


.section-header > p {

  max-width: 370px;

  margin: 0;

  color: #777;

  font-size: 0.84rem;

  line-height: 1.6;
}


.opportunities-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 12px;
}


/* ==================================================
   TARJETAS
================================================== */

.opportunity-card {

  position: relative;

  min-height: 285px;

  padding: 25px;

  overflow: hidden;

  background: #F7F4ED;

  border:
    1px solid
    rgba(27,27,27,0.07);

  border-radius: 14px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.opportunity-card:hover {

  transform: translateY(-4px);

  border-color:
    rgba(200,162,74,0.5);

  box-shadow:
    0 15px 30px
    rgba(27,27,27,0.08);
}


.opportunity-card.featured {

  background: #1B1B1B;

  color: #F7F4ED;
}


.card-number {

  position: absolute;

  top: 18px;

  right: 20px;

  color:
    rgba(27,27,27,0.25);

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 1.5px;
}


.featured .card-number {

  color:
    rgba(247,244,237,0.25);
}


.opportunity-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 42px;
  height: 42px;

  margin-bottom: 20px;

  color: #C8A24A;

  border:
    1px solid
    rgba(200,162,74,0.45);

  border-radius: 50%;

  font-size: 1rem;
}


.card-category {

  display: block;

  margin-bottom: 7px;

  color: #A8572B;

  font-size: 0.57rem;

  font-weight: 800;

  letter-spacing: 1.7px;
}


.featured .card-category {

  color: #C8A24A;
}


.opportunity-card h3 {

  margin: 0 0 11px;

  font-size: 1.2rem;

  line-height: 1.1;
}


.opportunity-card p {

  margin: 0;

  color: #777;

  font-size: 0.79rem;

  line-height: 1.55;
}


.featured p {

  color:
    rgba(247,244,237,0.65);
}


/* ==================================================
   CONVOCATORIA
================================================== */

.convocatoria-destacada {

  padding: 65px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.convocatoria-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 35px;

  margin-bottom: 35px;
}


.convocatoria-header h2 {

  margin: 0;

  font-size:
    clamp(2.1rem, 4vw, 3.3rem);

  line-height: 1;

  letter-spacing: -1.5px;
}


.convocatoria-header h2 span {

  display: block;

  color: #A8572B;
}


.convocatoria-header > p {

  max-width: 370px;

  margin: 0;

  color: #777;

  font-size: 0.84rem;

  line-height: 1.6;
}


/* ==================================================
   TARJETA CONVOCATORIA
================================================== */

.convocatoria-card {

  display: grid;

  grid-template-columns: 1fr 1fr;

  width: 100%;

  height: 450px;

  min-height: 450px;

  max-height: 450px;

  overflow: hidden;

  background: #FFFFFF;

  border-radius: 18px;

  box-shadow:
    0 18px 38px
    rgba(27,27,27,0.1);
}


/* ==================================================
   VISUAL
================================================== */

.convocatoria-visual {

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  padding: 30px;

  overflow: hidden;

  background: #1B1B1B;

  color: #F7F4ED;
}


.visual-top,
.visual-bottom {

  display: flex;

  justify-content: space-between;

  gap: 15px;

  font-size: 0.6rem;

  font-weight: 800;

  letter-spacing: 1.7px;
}


.visual-top span:last-child,
.visual-bottom span:first-child {

  color: #C8A24A;
}


.visual-center {

  max-width: 390px;
}


.visual-number {

  display: block;

  margin-bottom: 14px;

  color: #C8A24A;

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 2.5px;
}


.visual-center h3 {

  margin: 0;

  font-size:
    clamp(1.9rem, 3vw, 2.4rem);

  line-height: 1.05;

  letter-spacing: -0.8px;
}


.visual-center h3 span {

  display: block;

  color: #C8A24A;
}


.visual-center p {

  margin: 15px 0 0;

  color: #D9D4C8;

  font-size: 0.78rem;

  letter-spacing: 0.8px;
}


/* ==================================================
   CONTENIDO
================================================== */

.convocatoria-content {

  display: flex;

  flex-direction: column;

  justify-content: center;

  padding: 28px 35px;

  overflow: hidden;
}


.convocatoria-meta {

  display: flex;

  gap: 8px;

  margin-bottom: 10px;

  color: #A8572B;

  font-size: 0.57rem;

  font-weight: 800;

  letter-spacing: 1.5px;
}


.convocatoria-content h3 {

  margin: 0 0 12px;

  font-size:
    clamp(1.55rem, 2.3vw, 2rem);

  line-height: 1.06;

  letter-spacing: -0.7px;
}


.convocatoria-content > p {

  max-width: 450px;

  margin: 0;

  color: #555;

  font-size: 0.78rem;

  line-height: 1.5;
}


/* ==================================================
   DATOS
================================================== */

.datos-convocatoria {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 10px;

  margin-top: 17px;

  padding-top: 15px;

  border-top:
    1px solid
    #E5E0D7;
}


.datos-convocatoria div {

  display: flex;

  flex-direction: column;

  gap: 3px;
}


.datos-convocatoria span {

  color: #A8572B;

  font-size: 0.52rem;

  font-weight: 800;

  letter-spacing: 1.3px;
}


.datos-convocatoria strong {

  color: #1B1B1B;

  font-size: 0.63rem;

  line-height: 1.25;
}


/* ==================================================
   BOTÓN
================================================== */

.convocatoria-footer {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 12px;

  margin-top: 16px;
}


.convocatoria-button {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  padding: 9px 15px;

  background: #A8572B;

  color: #FFFFFF;

  text-decoration: none;

  font-size: 0.58rem;

  font-weight: 800;

  letter-spacing: 0.9px;

  text-transform: uppercase;

  transition:
    0.25s ease;
}


.convocatoria-button:hover {

  background: #1B1B1B;
}


.convocatoria-button span {

  font-size: 0.9rem;
}


.convocatoria-category {

  color: #888;

  font-size: 0.52rem;

  font-weight: 800;

  line-height: 1.35;

  letter-spacing: 1.2px;

  text-align: right;
}


/* ==================================================
   AVISO
================================================== */

.oportunidades-aviso {

  padding: 65px 20px;

  background: #F7F4ED;
}


.aviso-box {

  display: grid;

  grid-template-columns: 55px 1fr;

  gap: 22px;

  align-items: start;

  padding: 32px;

  background: #FFFFFF;

  border:
    1px solid
    rgba(27,27,27,0.08);

  border-left:
    3px solid
    #C8A24A;

  border-radius: 14px;
}


.aviso-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 45px;

  height: 45px;

  background:
    rgba(200,162,74,0.12);

  color: #A8572B;

  border-radius: 50%;

  font-size: 1.2rem;

  font-weight: 800;
}


.aviso-box span {

  color: #A8572B;

  font-size: 0.58rem;

  font-weight: 800;

  letter-spacing: 1.7px;
}


.aviso-box h2 {

  max-width: 650px;

  margin: 9px 0;

  color: #1B1B1B;

  font-size:
    clamp(1.6rem, 3vw, 2.3rem);

  line-height: 1.1;
}


.aviso-box p {

  max-width: 650px;

  margin: 0;

  color: #666;

  font-size: 0.82rem;

  line-height: 1.6;
}


/* ==================================================
   FRASE
================================================== */

.oportunidades-frase {

  padding: 80px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.oportunidades-frase span {

  display: block;

  margin-bottom: 18px;

  color: #C8A24A;

  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 4px;
}


.oportunidades-frase h2 {

  max-width: 700px;

  margin: 0 auto;

  font-size:
    clamp(1.9rem, 4vw, 2.9rem);

  line-height: 1.1;

  letter-spacing: -0.8px;
}


.oportunidades-frase strong {

  display: block;

  color: #C8A24A;
}


.oportunidades-frase p {

  margin: 22px 0 0;

  color:
    rgba(247,244,237,0.45);

  font-size: 0.58rem;

  letter-spacing: 2.3px;
}


/* ==================================================
   CIERRE
================================================== */

.oportunidades-cierre {

  padding: 65px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.cierre-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 55px;

  align-items: center;
}


.cierre-grid h2 {

  margin: 0;

  font-size:
    clamp(2.1rem, 4vw, 3.3rem);

  line-height: 1;

  letter-spacing: -1.5px;
}


.cierre-grid h2 span {

  display: block;

  color: #A8572B;
}


.cierre-grid p {

  margin: 0;

  color: #666;

  font-size: 0.86rem;

  line-height: 1.6;
}


.button {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  margin-top: 20px;

  padding: 11px 18px;

  background: #C8A24A;

  color: #1B1B1B;

  border-radius: 22px;

  font-size: 0.72rem;

  font-weight: 800;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}


.button:hover {

  transform: translateY(-2px);

  background: #D8B65F;
}


.button span {

  font-size: 1rem;
}


/* ==================================================
   TABLET
================================================== */

@media (max-width: 800px) {

  .oportunidades-hero {

    min-height: 420px;
  }


  .oportunidades-hero h1 {

    letter-spacing: -2px;
  }


  .intro-grid,
  .cierre-grid {

    grid-template-columns: 1fr;

    gap: 35px;
  }


  .section-header,
  .convocatoria-header {

    display: block;
  }


  .section-header > p,
  .convocatoria-header > p {

    margin-top: 16px;
  }


  .opportunities-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }


  .convocatoria-card {

    grid-template-columns: 1fr;

    height: auto;

    min-height: 0;

    max-height: none;
  }


  .convocatoria-visual {

    min-height: 350px;
  }


  .convocatoria-content {

    padding: 35px;
  }

}


/* ==================================================
   CELULAR
================================================== */

@media (max-width: 550px) {

  .container {

    width:
      calc(100% - 32px);
  }


  /* HERO */

  .oportunidades-hero {

    min-height: 390px;

    overflow: hidden;

    background: #1B1B1B !important;

    color: #F7F4ED !important;
  }


  .oportunidades-hero .container {

    padding: 50px 0;
  }


  .oportunidades-hero h1 {

    max-width: 100%;

    font-size:
      clamp(3rem, 11vw, 4rem);

    line-height: 0.98;

    letter-spacing: -2px;
  }


  .oportunidades-hero p {

    max-width: 100%;

    margin-top: 20px;

    color:
      rgba(247,244,237,0.72) !important;

    font-size: 0.82rem;
  }


  /* INTRO */

  .oportunidades-intro {

    padding: 55px 16px;

    background: #F7F4ED !important;

    color: #1B1B1B !important;
  }


  .intro-grid h2 {

    font-size: 2.1rem;
  }


  .intro-text {

    font-size: 0.82rem;

    color: #666 !important;
  }


  /* CATEGORÍAS */

  .categorias {

    padding: 55px 16px;

    background: #FFFFFF !important;
  }


  .section-header h2 {

    font-size: 2.1rem;
  }


  .section-header > p {

    font-size: 0.82rem;
  }


  .opportunities-grid {

    grid-template-columns: 1fr;
  }


  .opportunity-card {

    min-height: 250px;

    padding: 24px;

    background: #F7F4ED !important;

    color: #1B1B1B !important;
  }


  .opportunity-card.featured {

    background: #1B1B1B !important;

    color: #F7F4ED !important;
  }


  /* CONVOCATORIA */

  .convocatoria-destacada {

    padding: 55px 16px;

    background: #F7F4ED !important;
  }


  .convocatoria-header h2 {

    font-size: 2.1rem;
  }


  .convocatoria-card {

    background: #FFFFFF !important;
  }


  .convocatoria-visual {

    min-height: 320px;

    padding: 24px;

    background: #1B1B1B !important;
  }


  .visual-center h3 {

    font-size: 1.9rem;
  }


  .convocatoria-content {

    padding: 28px 21px;

    background: #FFFFFF !important;
  }


  .convocatoria-content h3 {

    font-size: 1.6rem;

    color: #1B1B1B !important;
  }


  .convocatoria-content > p {

    font-size: 0.76rem;

    color: #555 !important;
  }


  .datos-convocatoria {

    grid-template-columns: 1fr;
  }


  .convocatoria-footer {

    align-items: flex-start;

    flex-direction: column;
  }


  .convocatoria-category {

    text-align: left;
  }


  /* AVISO */

  .oportunidades-aviso {

    padding: 55px 16px;

    background: #F7F4ED !important;
  }


  .aviso-box {

    grid-template-columns: 1fr;

    padding: 28px;

    background: #FFFFFF !important;
  }


  /* FRASE */

  .oportunidades-frase {

    padding: 65px 16px;

    background: #1B1B1B !important;
  }


  .oportunidades-frase h2 {

    font-size: 1.9rem;
  }


  /* CIERRE */

  .oportunidades-cierre {

    padding: 55px 16px;

    background: #F7F4ED !important;
  }


  .cierre-grid h2 {

    font-size: 2.1rem;
  }

}
