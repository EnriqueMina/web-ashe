---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Oportunidades">

  <!-- ================================
       HERO
  ================================= -->

  <section class="oportunidades-hero">

    <div class="hero-circle"></div>

    <div class="container">

      <span class="section-label">
        INFORMACIÓN PARA LA COMUNIDAD
      </span>

      <h1>
        Oportunidades
        <span>para crecer.</span>
      </h1>

      <p>
        Un espacio para encontrar convocatorias, formación,
        empleo y oportunidades que puedan aportar al desarrollo
        personal, académico y comunitario.
      </p>

    </div>

  </section>


  <!-- ================================
       INTRODUCCIÓN
  ================================= -->

  <section class="oportunidades-intro">

    <div class="container intro-grid">

      <div>

        <span class="small-label">
          ENCUENTRA NUEVAS POSIBILIDADES
        </span>

        <h2>
          Información que
          <span>abre caminos.</span>
        </h2>

      </div>

      <div class="intro-text">

        <p>
          Las oportunidades de formación, empleo, educación y
          participación pueden convertirse en herramientas para
          fortalecer nuestros proyectos de vida y nuestras comunidades.
        </p>

        <p>
          En ASHÉ queremos reunir y compartir información útil
          para que más personas puedan conocer diferentes opciones
          y acceder a nuevas posibilidades.
        </p>

      </div>

    </div>

  </section>


  <!-- ================================
       CATEGORÍAS
  ================================= -->

  <section class="categorias">

    <div class="container">

      <div class="section-header">

        <div>

          <span class="section-label">
            EXPLORA
          </span>

          <h2>
            Encuentra tu
            <span>oportunidad.</span>
          </h2>

        </div>

        <p>
          Consulta las diferentes categorías de información
          que iremos compartiendo desde ASHÉ.
        </p>

      </div>


      <div class="opportunities-grid">

        <!-- BECAS -->

        <article class="opportunity-card featured">

          <div class="card-number">
            01
          </div>

          <div class="opportunity-icon">
            ✦
          </div>

          <span class="card-category">
            EDUCACIÓN
          </span>

          <h3>
            Becas
          </h3>

          <p>
            Información sobre oportunidades de apoyo educativo,
            convocatorias académicas y alternativas para continuar
            procesos de formación.
          </p>

        </article>


        <!-- EMPLEO -->

        <article class="opportunity-card">

          <div class="card-number">
            02
          </div>

          <div class="opportunity-icon">
            +
          </div>

          <span class="card-category">
            TRABAJO
          </span>

          <h3>
            Empleo
          </h3>

          <p>
            Vacantes, iniciativas y oportunidades laborales que
            puedan ser de interés para nuestra comunidad.
          </p>

        </article>


        <!-- FORMACIÓN -->

        <article class="opportunity-card">

          <div class="card-number">
            03
          </div>

          <div class="opportunity-icon">
            ◇
          </div>

          <span class="card-category">
            APRENDIZAJE
          </span>

          <h3>
            Formación
          </h3>

          <p>
            Cursos, talleres, capacitaciones y espacios de aprendizaje
            para fortalecer conocimientos y habilidades.
          </p>

        </article>


        <!-- CONVOCATORIAS -->

        <article class="opportunity-card">

          <div class="card-number">
            04
          </div>

          <div class="opportunity-icon">
            ◉
          </div>

          <span class="card-category">
            PARTICIPACIÓN
          </span>

          <h3>
            Convocatorias
          </h3>

          <p>
            Invitaciones a proyectos, iniciativas y procesos
            comunitarios, culturales o educativos.
          </p>

        </article>


        <!-- EMPRENDIMIENTO -->

        <article class="opportunity-card featured">

          <div class="card-number">
            05
          </div>

          <div class="opportunity-icon">
            ◆
          </div>

          <span class="card-category">
            EMPRENDIMIENTO
          </span>

          <h3>
            Iniciativas
          </h3>

          <p>
            Espacios y oportunidades que puedan apoyar proyectos,
            emprendimientos e iniciativas de nuestra comunidad.
          </p>

        </article>


        <!-- COMUNIDAD -->

        <article class="opportunity-card">

          <div class="card-number">
            06
          </div>

          <div class="opportunity-icon">
            ∞
          </div>

          <span class="card-category">
            COMUNIDAD
          </span>

          <h3>
            Participación
          </h3>

          <p>
            Espacios para conocer iniciativas, actividades y procesos
            donde la comunidad pueda participar y aportar.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- ================================
       AVISO
  ================================= -->

  <section class="oportunidades-aviso">

    <div class="container aviso-box">

      <div class="aviso-icon">
        !
      </div>

      <div>

        <span>
          INFORMACIÓN EN CONSTRUCCIÓN
        </span>

        <h2>
          Próximamente encontrarás
          oportunidades destacadas.
        </h2>

        <p>
          Estamos preparando este espacio para compartir información
          útil y actualizada sobre becas, empleo, formación,
          convocatorias e iniciativas para la comunidad.
        </p>

      </div>

    </div>

  </section>


  <!-- ================================
       FRASE
  ================================= -->

  <section class="oportunidades-frase">

    <div class="container">

      <span>
        ASHÉ
      </span>

      <h2>
        Una oportunidad puede convertirse
        <strong>en un nuevo comienzo.</strong>
      </h2>

      <p>
        INFORMACIÓN · FORMACIÓN · PARTICIPACIÓN · COMUNIDAD
      </p>

    </div>

  </section>


  <!-- ================================
       CIERRE
  ================================= -->

  <section class="oportunidades-cierre">

    <div class="container cierre-grid">

      <div>

        <span class="section-label">
          SEGUIMOS CRECIENDO
        </span>

        <h2>
          Conectar información
          <span>también es construir comunidad.</span>
        </h2>

      </div>

      <div>

        <p>
          ASHÉ busca convertirse en un punto de encuentro para
          conocer información, iniciativas y oportunidades que
          puedan aportar al fortalecimiento de nuestras comunidades.
        </p>

        <a href="/comunidad" class="button">
          Conocer la comunidad
          <span>→</span>
        </a>

      </div>

    </div>

  </section>

</LayoutBase>


<style>

/* =================================
   GENERAL
================================= */

.container {

  width: min(1000px, calc(100% - 40px));

  margin: 0 auto;
}


.section-label {

  display: block;

  margin-bottom: 18px;

  color: #C8A24A;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


/* =================================
   HERO
================================= */

.oportunidades-hero {

  position: relative;

  min-height: 520px;

  display: flex;

  align-items: center;

  overflow: hidden;

  background: #1B1B1B;

  color: #F7F4ED;
}


.oportunidades-hero::before {

  content: "";

  position: absolute;

  width: 600px;

  height: 600px;

  right: -250px;

  top: -250px;

  border:
    1px solid rgba(200, 162, 74, 0.18);

  border-radius: 50%;

  box-shadow:
    0 0 0 80px rgba(200, 162, 74, 0.025),
    0 0 0 160px rgba(200, 162, 74, 0.015);
}


.hero-circle {

  position: absolute;

  width: 300px;

  height: 300px;

  left: -160px;

  bottom: -160px;

  border:
    1px solid rgba(168, 87, 43, 0.35);

  border-radius: 50%;
}


.oportunidades-hero .container {

  position: relative;

  z-index: 2;

  padding: 80px 0;
}


.oportunidades-hero h1 {

  max-width: 850px;

  margin: 0;

  font-size: clamp(3.5rem, 8vw, 6.5rem);

  line-height: 0.92;

  letter-spacing: -4px;
}


.oportunidades-hero h1 span {

  display: block;

  color: #C8A24A;
}


.oportunidades-hero p {

  max-width: 650px;

  margin: 35px 0 0;

  color:
    rgba(247, 244, 237, 0.72);

  font-size: 1.08rem;

  line-height: 1.75;
}


/* =================================
   INTRO
================================= */

.oportunidades-intro {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.intro-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}


.small-label {

  color: #A8572B;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.intro-grid h2 {

  margin: 18px 0 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.intro-grid h2 span {

  display: block;

  color: #A8572B;
}


.intro-text {

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


.intro-text p {

  margin: 0 0 20px;
}


/* =================================
   CATEGORÍAS
================================= */

.categorias {

  padding: 110px 20px;

  background: #FFFFFF;

  color: #1B1B1B;
}


.section-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 50px;

  margin-bottom: 55px;
}


.section-header h2 {

  margin: 0;

  font-size: clamp(2.6rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.section-header h2 span {

  color: #A8572B;
}


.section-header > p {

  max-width: 400px;

  margin: 0;

  color: #777;

  line-height: 1.7;
}


/* =================================
   TARJETAS
================================= */

.opportunities-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;
}


.opportunity-card {

  position: relative;

  min-height: 320px;

  padding: 32px;

  overflow: hidden;

  background: #F7F4ED;

  border:
    1px solid rgba(27, 27, 27, 0.07);

  border-radius: 16px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.opportunity-card:hover {

  transform: translateY(-5px);

  border-color:
    rgba(200, 162, 74, 0.5);

  box-shadow:
    0 18px 35px rgba(27, 27, 27, 0.08);
}


.opportunity-card.featured {

  background: #1B1B1B;

  color: #F7F4ED;
}


.card-number {

  position: absolute;

  top: 22px;

  right: 25px;

  color:
    rgba(27, 27, 27, 0.25);

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.featured .card-number {

  color:
    rgba(247, 244, 237, 0.25);
}


.opportunity-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 48px;

  height: 48px;

  margin-bottom: 22px;

  color: #C8A24A;

  border:
    1px solid rgba(200, 162, 74, 0.45);

  border-radius: 50%;

  font-size: 1.15rem;
}


.card-category {

  display: block;

  margin-bottom: 8px;

  color: #A8572B;

  font-size: 0.6rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.featured .card-category {

  color: #C8A24A;
}


.opportunity-card h3 {

  margin: 0 0 15px;

  font-size: 1.5rem;

  line-height: 1.1;
}


.opportunity-card p {

  margin: 0;

  color: #777;

  font-size: 0.9rem;

  line-height: 1.7;
}


.featured p {

  color:
    rgba(247, 244, 237, 0.65);
}


/* =================================
   AVISO
================================= */

.oportunidades-aviso {

  padding: 90px 20px;

  background: #F7F4ED;
}


.aviso-box {

  display: grid;

  grid-template-columns: 70px 1fr;

  gap: 30px;

  align-items: start;

  padding: 45px;

  background: #FFFFFF;

  border:
    1px solid rgba(27, 27, 27, 0.08);

  border-left:
    4px solid #C8A24A;

  border-radius: 15px;
}


.aviso-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 55px;

  height: 55px;

  background: rgba(200, 162, 74, 0.12);

  color: #A8572B;

  border-radius: 50%;

  font-size: 1.3rem;

  font-weight: 800;
}


.aviso-box span {

  color: #A8572B;

  font-size: 0.68rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.aviso-box h2 {

  max-width: 700px;

  margin: 12px 0;

  color: #1B1B1B;

  font-size: clamp(1.8rem, 4vw, 2.7rem);

  line-height: 1.1;
}


.aviso-box p {

  max-width: 700px;

  margin: 0;

  color: #666;

  line-height: 1.75;
}


/* =================================
   FRASE
================================= */

.oportunidades-frase {

  padding: 120px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.oportunidades-frase span {

  display: block;

  margin-bottom: 25px;

  color: #C8A24A;

  font-size: 0.8rem;

  font-weight: 800;

  letter-spacing: 5px;
}


.oportunidades-frase h2 {

  max-width: 850px;

  margin: 0 auto;

  font-size: clamp(2rem, 4vw, 3.5rem);

  line-height: 1.15;

  letter-spacing: -1px;
}


.oportunidades-frase strong {

  display: block;

  color: #C8A24A;
}


.oportunidades-frase p {

  margin: 30px 0 0;

  color:
    rgba(247, 244, 237, 0.45);

  font-size: 0.68rem;

  letter-spacing: 3px;
}


/* =================================
   CIERRE
================================= */

.oportunidades-cierre {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.cierre-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}


.cierre-grid h2 {

  margin: 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.cierre-grid h2 span {

  display: block;

  color: #A8572B;
}


.cierre-grid p {

  margin: 0;

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


.button {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  margin-top: 25px;

  padding: 14px 22px;

  background: #C8A24A;

  color: #1B1B1B;

  border-radius: 25px;

  font-size: 0.82rem;

  font-weight: 800;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}


.button:hover {

  transform: translateY(-3px);

  background: #D8B65F;
}


.button span {

  font-size: 1.1rem;
}


/* =================================
   RESPONSIVE
================================= */

@media (max-width: 800px) {

  .oportunidades-hero {

    min-height: 450px;
  }


  .oportunidades-hero h1 {

    letter-spacing: -2px;
  }


  .intro-grid,
  .cierre-grid {

    grid-template-columns: 1fr;

    gap: 40px;
  }


  .section-header {

    display: block;
  }


  .section-header > p {

    margin-top: 20px;
  }


  .opportunities-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

}


@media (max-width: 550px) {

  .oportunidades-hero .container {

    padding: 60px 0;
  }


  .oportunidades-intro,
  .categorias,
  .oportunidades-aviso,
  .oportunidades-cierre {

    padding: 80px 20px;
  }


  .opportunities-grid {

    grid-template-columns: 1fr;
  }


  .opportunity-card {

    min-height: auto;

    padding: 28px;
  }


  .aviso-box {

    grid-template-columns: 1fr;

    padding: 30px;
  }


  .oportunidades-frase {

    padding: 90px 20px;
  }


  .oportunidades-frase h2 {

    font-size: 2rem;
  }

}

</style>