---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Comunidad y Territorio">

  <!-- ================================
       ENCABEZADO
  ================================= -->

  <section class="comunidad-hero">

    <div class="hero-decoration"></div>

    <div class="container">

      <span class="section-label">
        DESDE EL TERRITORIO
      </span>

      <h1>
        Comunidad
        <span>y Territorio</span>
      </h1>

      <p>
        Voces, liderazgos y procesos colectivos que construyen
        comunidad y fortalecen el territorio desde las experiencias
        de las comunidades afrodescendientes.
      </p>

    </div>

  </section>


  <!-- ================================
       INTRODUCCIÓN
  ================================= -->

  <section class="introduccion">

    <div class="container intro-grid">

      <div>

        <span class="small-label">
          COMUNIDAD
        </span>

        <h2>
          Construimos territorio
          <span>desde lo colectivo.</span>
        </h2>

      </div>

      <div class="intro-text">

        <p>
          La comunidad es uno de los espacios fundamentales para
          fortalecer la identidad, compartir saberes y construir
          nuevas posibilidades para el territorio.
        </p>

        <p>
          En ASHÉ reconocemos y visibilizamos los procesos
          organizativos, los liderazgos y las iniciativas que nacen
          desde las comunidades afrodescendientes.
        </p>

      </div>

    </div>

  </section>


  <!-- ================================
       PILARES COMUNITARIOS
  ================================= -->

  <section class="pilares-comunidad">

    <div class="container">

      <div class="section-header">

        <div>

          <span class="section-label">
            NUESTRO TERRITORIO
          </span>

          <h2>
            Voces que
            <span>construyen.</span>
          </h2>

        </div>

        <p>
          Conoce algunos de los procesos que hacen parte de la vida
          comunitaria y fortalecen la participación colectiva.
        </p>

      </div>


      <div class="community-grid">

        <article class="community-card">

          <div class="card-number">
            01
          </div>

          <div class="card-icon">
            ◉
          </div>

          <h3>
            Liderazgos
            comunitarios
          </h3>

          <p>
            Reconocemos las voces de quienes trabajan por sus
            comunidades y promueven procesos de participación,
            organización y transformación social.
          </p>

        </article>


        <article class="community-card featured">

          <div class="card-number">
            02
          </div>

          <div class="card-icon">
            ◆
          </div>

          <h3>
            Organización
            colectiva
          </h3>

          <p>
            Visibilizamos iniciativas y procesos organizativos que
            fortalecen los vínculos comunitarios y generan espacios
            para la construcción colectiva.
          </p>

        </article>


        <article class="community-card">

          <div class="card-number">
            03
          </div>

          <div class="card-icon">
            +
          </div>

          <h3>
            Participación
            ciudadana
          </h3>

          <p>
            Promovemos el conocimiento y la participación en los
            espacios donde las comunidades pueden aportar a las
            decisiones que afectan sus territorios.
          </p>

        </article>


        <article class="community-card">

          <div class="card-number">
            04
          </div>

          <div class="card-icon">
            ◌
          </div>

          <h3>
            Juventudes
            y comunidad
          </h3>

          <p>
            Las nuevas generaciones tienen un papel fundamental en
            la construcción de memoria, identidad, cultura y nuevas
            formas de participación comunitaria.
          </p>

        </article>


        <article class="community-card featured">

          <div class="card-number">
            05
          </div>

          <div class="card-icon">
            ✦
          </div>

          <h3>
            Saberes
            compartidos
          </h3>

          <p>
            Los conocimientos transmitidos entre generaciones
            mantienen vivas las historias, prácticas y experiencias
            que hacen parte de nuestras comunidades.
          </p>

        </article>


        <article class="community-card">

          <div class="card-number">
            06
          </div>

          <div class="card-icon">
            ∞
          </div>

          <h3>
            Transformación
            territorial
          </h3>

          <p>
            Acompañamos y difundimos las historias de personas y
            colectivos que aportan a la construcción de territorios
            más participativos y solidarios.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- ================================
       FRASE DESTACADA
  ================================= -->

  <section class="frase">

    <div class="container">

      <span>
        ASHÉ
      </span>

      <h2>
        El territorio también se construye
        <strong>cuando nuestras voces se encuentran.</strong>
      </h2>

      <p>
        Comunidad · Identidad · Participación · Territorio
      </p>

    </div>

  </section>


  <!-- ================================
       CIERRE
  ================================= -->

  <section class="comunidad-cierre">

    <div class="container cierre-grid">

      <div>

        <span class="section-label">
          SEGUIMOS CONSTRUYENDO
        </span>

        <h2>
          Historias que nacen
          <span>desde la comunidad.</span>
        </h2>

      </div>

      <div>

        <p>
          En ASHÉ queremos abrir un espacio para conocer,
          compartir y visibilizar las experiencias de quienes
          construyen comunidad todos los días.
        </p>

        <a href="/memoria" class="button">
          Explorar historias
          <span>→</span>
        </a>

      </div>

    </div>

  </section>

</LayoutBase>


<style>

/* =================================
   GENERAL
================================= */

.container {
  width: min(1000px, calc(100% - 40px));
  margin: 0 auto;
}


/* =================================
   HERO
================================= */

.comunidad-hero {
  position: relative;

  min-height: 450px;

  display: flex;
  align-items: center;

  overflow: hidden;

  background: #1B1B1B;
  color: #F7F4ED;
}


.comunidad-hero::before {
  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  right: -230px;
  top: -230px;

  border:
    1px solid
    rgba(200, 162, 74, 0.18);

  border-radius: 50%;

  box-shadow:
    0 0 0 70px
    rgba(200, 162, 74, 0.025),

    0 0 0 140px
    rgba(200, 162, 74, 0.015);
}


.hero-decoration {
  position: absolute;

  width: 260px;
  height: 260px;

  left: -140px;
  bottom: -140px;

  border:
    1px solid
    rgba(168, 87, 43, 0.3);

  border-radius: 50%;
}


.section-label {
  display: block;

  margin-bottom: 12px;

  color: #C8A24A;

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 2.3px;
}


.comunidad-hero .container {
  position: relative;

  z-index: 2;

  padding: 60px 0;
}


.comunidad-hero h1 {
  max-width: 750px;

  margin: 0;

  font-size: clamp(
    3.2rem,
    7vw,
    5.8rem
  );

  line-height: 0.92;

  letter-spacing: -3px;
}


.comunidad-hero h1 span {
  display: block;

  color: #C8A24A;
}


.comunidad-hero p {
  max-width: 590px;

  margin: 24px 0 0;

  color:
    rgba(
      247,
      244,
      237,
      0.72
    );

  font-size: 0.92rem;

  line-height: 1.6;
}


/* =================================
   INTRODUCCIÓN
================================= */

.introduccion {
  padding: 65px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.intro-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 55px;

  align-items: center;
}


.small-label {
  color: #A8572B;

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 2.3px;
}


.intro-grid h2 {
  margin: 14px 0 0;

  font-size: clamp(
    2.1rem,
    4vw,
    3.3rem
  );

  line-height: 1;

  letter-spacing: -1.5px;
}


.intro-grid h2 span {
  display: block;

  color: #A8572B;
}


.intro-text {
  color: #666;

  font-size: 0.86rem;

  line-height: 1.65;
}


.intro-text p {
  margin: 0 0 15px;
}


/* =================================
   PILARES
================================= */

.pilares-comunidad {
  padding: 65px 20px;

  background: #FFFFFF;

  color: #1B1B1B;
}


.section-header {
  display: flex;

  justify-content: space-between;
  align-items: flex-end;

  gap: 35px;

  margin-bottom: 35px;
}


.section-header h2 {
  margin: 0;

  font-size: clamp(
    2.1rem,
    4vw,
    3.3rem
  );

  line-height: 1;

  letter-spacing: -1.5px;
}


.section-header h2 span {
  color: #A8572B;
}


.section-header > p {
  max-width: 370px;

  margin: 0;

  color: #777;

  font-size: 0.84rem;

  line-height: 1.6;
}


/* =================================
   TARJETAS
================================= */

.community-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 12px;
}


.community-card {
  position: relative;

  min-height: 285px;

  padding: 25px;

  overflow: hidden;

  background: #F7F4ED;

  border:
    1px solid
    rgba(
      27,
      27,
      27,
      0.07
    );

  border-radius: 14px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.community-card:hover {
  transform: translateY(-4px);

  border-color:
    rgba(
      200,
      162,
      74,
      0.5
    );

  box-shadow:
    0 15px 30px
    rgba(
      27,
      27,
      27,
      0.08
    );
}


.community-card.featured {
  background: #1B1B1B;

  color: #F7F4ED;
}


.card-number {
  position: absolute;

  top: 18px;
  right: 20px;

  color:
    rgba(
      27,
      27,
      27,
      0.25
    );

  font-size: 0.62rem;

  font-weight: 800;

  letter-spacing: 1.5px;
}


.featured .card-number {
  color:
    rgba(
      247,
      244,
      237,
      0.25
    );
}


.card-icon {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 42px;
  height: 42px;

  margin-bottom: 20px;

  color: #C8A24A;

  border:
    1px solid
    rgba(
      200,
      162,
      74,
      0.45
    );

  border-radius: 50%;

  font-size: 1rem;
}


.community-card h3 {
  max-width: 220px;

  margin: 0 0 10px;

  font-size: 1.2rem;

  line-height: 1.1;
}


.community-card p {
  margin: 0;

  color: #777;

  font-size: 0.79rem;

  line-height: 1.55;
}


.featured p {
  color:
    rgba(
      247,
      244,
      237,
      0.65
    );
}


/* =================================
   FRASE
================================= */

.frase {
  padding: 80px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.frase span {
  display: block;

  margin-bottom: 18px;

  color: #C8A24A;

  font-size: 0.65rem;

  font-weight: 800;

  letter-spacing: 4px;
}


.frase h2 {
  max-width: 760px;

  margin: 0 auto;

  font-size: clamp(
    1.8rem,
    3.5vw,
    2.8rem
  );

  line-height: 1.12;

  letter-spacing: -0.8px;
}


.frase strong {
  display: block;

  color: #C8A24A;
}


.frase p {
  margin: 22px 0 0;

  color:
    rgba(
      247,
      244,
      237,
      0.45
    );

  font-size: 0.56rem;

  letter-spacing: 2.3px;
}


/* =================================
   CIERRE
================================= */

.comunidad-cierre {
  padding: 65px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.cierre-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 55px;

  align-items: center;
}


.cierre-grid h2 {
  margin: 0;

  font-size: clamp(
    2.1rem,
    4vw,
    3.3rem
  );

  line-height: 1;

  letter-spacing: -1.5px;
}


.cierre-grid h2 span {
  display: block;

  color: #A8572B;
}


.cierre-grid p {
  margin: 0;

  color: #666;

  font-size: 0.86rem;

  line-height: 1.65;
}


.button {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  margin-top: 20px;

  padding: 11px 18px;

  background: #C8A24A;

  color: #1B1B1B;

  border-radius: 23px;

  font-size: 0.72rem;

  font-weight: 800;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}


.button:hover {
  transform: translateY(-2px);

  background: #D8B65F;
}


.button span {
  font-size: 1rem;
}


/* =================================
   TABLET
================================= */

@media (max-width: 800px) {

  .comunidad-hero {
    min-height: 400px;
  }


  .intro-grid,
  .cierre-grid {
    grid-template-columns: 1fr;

    gap: 35px;
  }


  .section-header {
    display: block;
  }


  .section-header > p {
    margin-top: 16px;
  }


  .community-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

}


/* =================================
   CELULAR
================================= */

@media (max-width: 550px) {

  .container {
    width:
      calc(
        100% - 32px
      );
  }


  .comunidad-hero {
    min-height: 390px;
  }


  .comunidad-hero .container {
    padding: 50px 0;
  }


  .comunidad-hero h1 {
    font-size: clamp(
      3rem,
      15vw,
      4.5rem
    );

    letter-spacing: -2px;
  }


  .comunidad-hero p {
    margin-top: 20px;

    font-size: 0.82rem;
  }


  .introduccion,
  .pilares-comunidad,
  .comunidad-cierre {
    padding: 55px 16px;
  }


  .intro-grid h2,
  .section-header h2,
  .cierre-grid h2 {
    font-size: 2.1rem;
  }


  .intro-text,
  .section-header > p,
  .cierre-grid p {
    font-size: 0.8rem;
  }


  .community-grid {
    grid-template-columns: 1fr;
  }


  .community-card {
    min-height: 265px;

    padding: 24px;
  }


  .community-card h3 {
    font-size: 1.15rem;
  }


  .community-card p {
    font-size: 0.77rem;
  }


  .frase {
    padding: 65px 16px;
  }


  .frase h2 {
    font-size: 1.8rem;
  }


  .frase p {
    font-size: 0.5rem;

    line-height: 1.6;
  }

}

</style>