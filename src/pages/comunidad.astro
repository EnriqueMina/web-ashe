---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Comunidad y Territorio">

  <!-- ================================
       ENCABEZADO
  ================================= -->

  <section class="comunidad-hero">

    <div class="hero-decoration"></div>

    <div class="container">

      <span class="section-label">
        DESDE EL TERRITORIO
      </span>

      <h1>
        Comunidad
        <span>y Territorio</span>
      </h1>

      <p>
        Voces, liderazgos y procesos colectivos que construyen
        comunidad y fortalecen el territorio desde las experiencias
        de las comunidades afrodescendientes.
      </p>

    </div>

  </section>


  <!-- ================================
       INTRODUCCIÓN
  ================================= -->

  <section class="introduccion">

    <div class="container intro-grid">

      <div>

        <span class="small-label">
          COMUNIDAD
        </span>

        <h2>
          Construimos territorio
          <span>desde lo colectivo.</span>
        </h2>

      </div>

      <div class="intro-text">

        <p>
          La comunidad es uno de los espacios fundamentales para
          fortalecer la identidad, compartir saberes y construir
          nuevas posibilidades para el territorio.
        </p>

        <p>
          En ASHÉ reconocemos y visibilizamos los procesos
          organizativos, los liderazgos y las iniciativas que nacen
          desde las comunidades afrodescendientes.
        </p>

      </div>

    </div>

  </section>


  <!-- ================================
       PILARES COMUNITARIOS
  ================================= -->

  <section class="pilares-comunidad">

    <div class="container">

      <div class="section-header">

        <div>

          <span class="section-label">
            NUESTRO TERRITORIO
          </span>

          <h2>
            Voces que
            <span>construyen.</span>
          </h2>

        </div>

        <p>
          Conoce algunos de los procesos que hacen parte de la vida
          comunitaria y fortalecen la participación colectiva.
        </p>

      </div>


      <div class="community-grid">

        <!-- TARJETA 1 -->

        <article class="community-card">

          <div class="card-number">
            01
          </div>

          <div class="card-icon">
            ◉
          </div>

          <h3>
            Liderazgos
            comunitarios
          </h3>

          <p>
            Reconocemos las voces de quienes trabajan por sus
            comunidades y promueven procesos de participación,
            organización y transformación social.
          </p>

        </article>


        <!-- TARJETA 2 -->

        <article class="community-card featured">

          <div class="card-number">
            02
          </div>

          <div class="card-icon">
            ◆
          </div>

          <h3>
            Organización
            colectiva
          </h3>

          <p>
            Visibilizamos iniciativas y procesos organizativos que
            fortalecen los vínculos comunitarios y generan espacios
            para la construcción colectiva.
          </p>

        </article>


        <!-- TARJETA 3 -->

        <article class="community-card">

          <div class="card-number">
            03
          </div>

          <div class="card-icon">
            +
          </div>

          <h3>
            Participación
            ciudadana
          </h3>

          <p>
            Promovemos el conocimiento y la participación en los
            espacios donde las comunidades pueden aportar a las
            decisiones que afectan sus territorios.
          </p>

        </article>


        <!-- TARJETA 4 -->

        <article class="community-card">

          <div class="card-number">
            04
          </div>

          <div class="card-icon">
            ◌
          </div>

          <h3>
            Juventudes
            y comunidad
          </h3>

          <p>
            Las nuevas generaciones tienen un papel fundamental en
            la construcción de memoria, identidad, cultura y nuevas
            formas de participación comunitaria.
          </p>

        </article>


        <!-- TARJETA 5 -->

        <article class="community-card featured">

          <div class="card-number">
            05
          </div>

          <div class="card-icon">
            ✦
          </div>

          <h3>
            Saberes
            compartidos
          </h3>

          <p>
            Los conocimientos transmitidos entre generaciones
            mantienen vivas las historias, prácticas y experiencias
            que hacen parte de nuestras comunidades.
          </p>

        </article>


        <!-- TARJETA 6 -->

        <article class="community-card">

          <div class="card-number">
            06
          </div>

          <div class="card-icon">
            ∞
          </div>

          <h3>
            Transformación
            territorial
          </h3>

          <p>
            Acompañamos y difundimos las historias de personas y
            colectivos que aportan a la construcción de territorios
            más participativos y solidarios.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- ================================
       FRASE DESTACADA
  ================================= -->

  <section class="frase">

    <div class="container">

      <span>
        ASHÉ
      </span>

      <h2>
        El territorio también se construye
        <strong>cuando nuestras voces se encuentran.</strong>
      </h2>

      <p>
        Comunidad · Identidad · Participación · Territorio
      </p>

    </div>

  </section>


  <!-- ================================
       CIERRE
  ================================= -->

  <section class="comunidad-cierre">

    <div class="container cierre-grid">

      <div>

        <span class="section-label">
          SEGUIMOS CONSTRUYENDO
        </span>

        <h2>
          Historias que nacen
          <span>desde la comunidad.</span>
        </h2>

      </div>

      <div>

        <p>
          En ASHÉ queremos abrir un espacio para conocer,
          compartir y visibilizar las experiencias de quienes
          construyen comunidad todos los días.
        </p>

        <a href="/memoria" class="button">
          Explorar historias
          <span>→</span>
        </a>

      </div>

    </div>

  </section>

</LayoutBase>


<style>

/* =================================
   GENERAL
================================= */

.container {

  width: min(1000px, calc(100% - 40px));

  margin: 0 auto;
}


/* =================================
   HERO
================================= */

.comunidad-hero {

  position: relative;

  min-height: 520px;

  display: flex;

  align-items: center;

  overflow: hidden;

  background: #1B1B1B;

  color: #F7F4ED;
}


.comunidad-hero::before {

  content: "";

  position: absolute;

  width: 600px;

  height: 600px;

  right: -250px;

  top: -250px;

  border:
    1px solid rgba(200, 162, 74, 0.2);

  border-radius: 50%;

  box-shadow:
    0 0 0 80px rgba(200, 162, 74, 0.025),
    0 0 0 160px rgba(200, 162, 74, 0.015);
}


.hero-decoration {

  position: absolute;

  width: 300px;

  height: 300px;

  left: -150px;

  bottom: -170px;

  border:
    1px solid rgba(168, 87, 43, 0.3);

  border-radius: 50%;
}


.comunidad-hero .container {

  position: relative;

  z-index: 2;

  padding: 80px 0;
}


.section-label {

  display: block;

  margin-bottom: 18px;

  color: #C8A24A;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.comunidad-hero h1 {

  max-width: 800px;

  margin: 0;

  font-size: clamp(3.8rem, 9vw, 7rem);

  line-height: 0.92;

  letter-spacing: -4px;
}


.comunidad-hero h1 span {

  display: block;

  color: #C8A24A;
}


.comunidad-hero p {

  max-width: 650px;

  margin: 35px 0 0;

  color: rgba(247, 244, 237, 0.72);

  font-size: 1.08rem;

  line-height: 1.75;
}


/* =================================
   INTRODUCCIÓN
================================= */

.introduccion {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.intro-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}


.small-label {

  color: #A8572B;

  font-size: 0.72rem;

  font-weight: 800;

  letter-spacing: 3px;
}


.intro-grid h2 {

  margin: 18px 0 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.intro-grid h2 span {

  display: block;

  color: #A8572B;
}


.intro-text {

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


.intro-text p {

  margin: 0 0 20px;
}


/* =================================
   PILARES
================================= */

.pilares-comunidad {

  padding: 110px 20px;

  background: #FFFFFF;

  color: #1B1B1B;
}


.section-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 50px;

  margin-bottom: 55px;
}


.section-header h2 {

  margin: 0;

  font-size: clamp(2.6rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.section-header h2 span {

  color: #A8572B;
}


.section-header > p {

  max-width: 400px;

  margin: 0;

  color: #777;

  line-height: 1.7;
}


/* =================================
   TARJETAS
================================= */

.community-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;
}


.community-card {

  position: relative;

  min-height: 300px;

  padding: 32px;

  overflow: hidden;

  background: #F7F4ED;

  border:
    1px solid rgba(27, 27, 27, 0.07);

  border-radius: 16px;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}


.community-card:hover {

  transform: translateY(-5px);

  border-color:
    rgba(200, 162, 74, 0.5);

  box-shadow:
    0 18px 35px rgba(27, 27, 27, 0.08);
}


.community-card.featured {

  background: #1B1B1B;

  color: #F7F4ED;
}


.card-number {

  position: absolute;

  top: 22px;

  right: 25px;

  color: rgba(27, 27, 27, 0.25);

  font-size: 0.7rem;

  font-weight: 800;

  letter-spacing: 2px;
}


.featured .card-number {

  color:
    rgba(247, 244, 237, 0.25);
}


.card-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 45px;

  height: 45px;

  margin-bottom: 30px;

  color: #C8A24A;

  border:
    1px solid rgba(200, 162, 74, 0.45);

  border-radius: 50%;

  font-size: 1.1rem;
}


.community-card h3 {

  max-width: 230px;

  margin: 0 0 15px;

  font-size: 1.45rem;

  line-height: 1.1;
}


.community-card p {

  margin: 0;

  color: #777;

  font-size: 0.9rem;

  line-height: 1.7;
}


.featured p {

  color:
    rgba(247, 244, 237, 0.65);
}


/* =================================
   FRASE
================================= */

.frase {

  padding: 120px 20px;

  background: #1B1B1B;

  color: #F7F4ED;

  text-align: center;
}


.frase span {

  display: block;

  margin-bottom: 25px;

  color: #C8A24A;

  font-size: 0.8rem;

  font-weight: 800;

  letter-spacing: 5px;
}


.frase h2 {

  max-width: 850px;

  margin: 0 auto;

  font-size: clamp(2rem, 4vw, 3.5rem);

  line-height: 1.15;

  letter-spacing: -1px;
}


.frase strong {

  display: block;

  color: #C8A24A;
}


.frase p {

  margin: 30px 0 0;

  color:
    rgba(247, 244, 237, 0.45);

  font-size: 0.68rem;

  letter-spacing: 3px;
}


/* =================================
   CIERRE
================================= */

.comunidad-cierre {

  padding: 110px 20px;

  background: #F7F4ED;

  color: #1B1B1B;
}


.cierre-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}


.cierre-grid h2 {

  margin: 0;

  font-size: clamp(2.5rem, 5vw, 4rem);

  line-height: 1;

  letter-spacing: -2px;
}


.cierre-grid h2 span {

  display: block;

  color: #A8572B;
}


.cierre-grid p {

  margin: 0;

  color: #666;

  font-size: 1rem;

  line-height: 1.8;
}


.button {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  margin-top: 25px;

  padding: 14px 22px;

  background: #C8A24A;

  color: #1B1B1B;

  border-radius: 25px;

  font-size: 0.82rem;

  font-weight: 800;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    background 0.2s ease;
}


.button:hover {

  transform: translateY(-3px);

  background: #D8B65F;
}


.button span {

  font-size: 1.1rem;
}


/* =================================
   RESPONSIVE
================================= */

@media (max-width: 800px) {

  .comunidad-hero {

    min-height: 450px;
  }


  .comunidad-hero h1 {

    letter-spacing: -2px;
  }


  .intro-grid,
  .cierre-grid {

    grid-template-columns: 1fr;

    gap: 40px;
  }


  .section-header {

    display: block;
  }


  .section-header > p {

    margin-top: 20px;
  }


  .community-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

}


@media (max-width: 550px) {

  .comunidad-hero .container {

    padding: 60px 0;
  }


  .introduccion,
  .pilares-comunidad,
  .comunidad-cierre {

    padding: 80px 20px;
  }


  .community-grid {

    grid-template-columns: 1fr;
  }


  .community-card {

    min-height: auto;

    padding: 28px;
  }


  .frase {

    padding: 90px 20px;
  }


  .frase h2 {

    font-size: 2rem;
  }

}

</style>